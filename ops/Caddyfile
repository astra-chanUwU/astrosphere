astrosphere.example.com {
	redir /manga /shelf permanent
	redir /manga/ /shelf permanent
	redir /image-sets /shelf/image-sets permanent
	redir /image-sets/ /shelf/image-sets permanent

	@mangaMedia path_regexp ^/manga/.+\.(?:avif|gif|jpe?g|png|webp)$
	handle @mangaMedia {
		uri strip_prefix /manga
		root * /srv/astrosphere/media/manga
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle_path /media/images/* {
		root * /srv/astrosphere/media/images
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/astrosphere/site
		encode zstd gzip
		file_server
	}
}
