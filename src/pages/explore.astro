---
import ArtifactCard from "../components/ArtifactCard.astro";
import SphereCard from "../components/SphereCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedArtifacts, getPublishedSpheres, getPublishedTrails } from "../lib/content";

const [spheres, artifacts, trails] = await Promise.all([
  getPublishedSpheres(),
  getPublishedArtifacts(),
  getPublishedTrails(),
]);

const roots = spheres.filter((sphere) => !sphere.data.parent);
const countsFor = (sphereSlug: string) => ({
  childCount: spheres.filter((child) => child.data.parent === sphereSlug).length,
  artifactCount: artifacts.filter((artifact) => artifact.data.spheres.includes(sphereSlug)).length,
});
const recentArtifacts = artifacts.slice(0, 4);
const featuredTrails = trails.filter((trail) => trail.data.featured).slice(0, 4);
---

<BaseLayout title="Explore" description="Enter AstroSphere through spheres, artifacts, trails, and signals.">
  <div class="page-shell explore-page">
    <header class="explore-header">
      <p class="eyebrow">Archive index</p>
      <h1>Explore</h1>
      <p>Find a way in through territories, objects, and routes.</p>
    </header>

    <div class="explore-grid">
      <main class="explore-main">
        <div class="section-heading"><div><p class="eyebrow">Thematic territories</p><h2>Spheres</h2></div><a href="/spheres">All spheres →</a></div>
        <div class="sphere-list">{roots.map((sphere) => <SphereCard {sphere} {...countsFor(sphere.data.slug)} />)}</div>
      </main>

      <aside class="explore-rail">
        <nav class="explore-links" aria-labelledby="explore-links-title">
          <p id="explore-links-title" class="eyebrow">Explore by kind</p>
          <a href="/spheres">Spheres <span>{spheres.length}</span></a>
          <a href="/artifacts">Artifacts <span>{artifacts.length}</span></a>
          <a href="/trails">Trails <span>{trails.length}</span></a>
          <a href="/signals">Signals <span>→</span></a>
        </nav>

        <section aria-labelledby="recent-artifacts-title">
          <div class="rail-heading"><h2 id="recent-artifacts-title">Recent artifacts</h2><a href="/artifacts">All →</a></div>
          <div class="artifact-list">{recentArtifacts.map((artifact) => <ArtifactCard {artifact} />)}</div>
        </section>

        {featuredTrails.length > 0 && <section aria-labelledby="featured-trails-title"><div class="rail-heading"><h2 id="featured-trails-title">Featured trails</h2><a href="/trails">All →</a></div><ul class="trail-list">{featuredTrails.map((trail) => <li><a href={`/trails/${trail.data.slug}`}>{trail.data.title}</a><span>{trail.data.items.length} stops</span></li>)}</ul></section>}
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .explore-page { max-width: 96rem; padding-bottom: var(--section-space); }
  .explore-header { max-width: var(--reading-width); padding: clamp(2rem, 5vw, 5rem) 0 var(--section-space); }
  .eyebrow { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); margin: 0 0 var(--space-1); text-transform: uppercase; }
  h1, h2 { font-family: var(--font-serif); font-weight: 500; line-height: var(--leading-tight); }
  h1 { font-size: clamp(3rem, 7vw, 6rem); letter-spacing: -.06em; margin: 0; }
  .explore-header > p:last-child { font-family: var(--font-serif); font-size: var(--text-lg); line-height: var(--leading-reading); margin: var(--space-2) 0 0; }
  .explore-grid { align-items: start; display: grid; gap: clamp(3rem, 7vw, 8rem); grid-template-columns: minmax(0, 1.5fr) minmax(16rem, .75fr); }
  .section-heading, .rail-heading { align-items: end; border-bottom: 1px solid var(--color-border); display: flex; gap: var(--space-3); justify-content: space-between; padding-bottom: var(--space-2); }
  .section-heading h2, .rail-heading h2 { font-size: clamp(1.6rem, 3vw, 2.5rem); margin: 0; }
  .section-heading a, .rail-heading a { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); text-transform: uppercase; }
  .sphere-list { border-top: 1px solid var(--color-border); }
  .explore-rail { border-left: 1px solid var(--color-border); padding-left: var(--space-3); }
  .explore-links { display: grid; margin-bottom: var(--section-space); }
  .explore-links a { align-items: baseline; border-bottom: 1px solid var(--color-border); display: flex; font-family: var(--font-serif); font-size: var(--text-xl); justify-content: space-between; padding: var(--space-2) 0; text-decoration: none; }
  .explore-links a span, .trail-list span { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); text-transform: uppercase; }
  .explore-rail section { margin-top: var(--section-space); }
  .artifact-list { border-top: 1px solid var(--color-border); }
  .artifact-list :global(article) { border-top: 0; }
  .trail-list { border-top: 1px solid var(--color-border); list-style: none; margin: 0; padding: 0; }
  .trail-list li { align-items: baseline; border-bottom: 1px solid var(--color-border); display: flex; gap: var(--space-2); justify-content: space-between; padding: var(--space-2) 0; }
  .trail-list a { text-decoration: none; }
  @media (max-width: 52rem) { .explore-grid { grid-template-columns: minmax(0, 1fr); } .explore-rail { border-left: 0; border-top: 1px solid var(--color-border); padding: var(--space-3) 0 0; } }
</style>
