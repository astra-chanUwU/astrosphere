---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArtifactCard from "../../components/ArtifactCard.astro";
import ArchivePagination from "../../components/ArchivePagination.astro";
import { ARCHIVE_PAGE_SIZE } from "../../lib/archive";
import { getPublishedArtifacts } from "../../lib/content";

const artifacts = await getPublishedArtifacts();
const currentPage = 1;
const lastPage = Math.ceil(artifacts.length / ARCHIVE_PAGE_SIZE);
---
<BaseLayout title="Artifacts" description="All published objects in the AstroSphere archive.">
  <div class="page-shell artifact-archive">
    <header>
      <p class="eyebrow">Field guide / archive 01</p><h1>Artifacts</h1><p class="lede">A constellation of essays, notes, recordings, experiments, and durable objects gathered from the edges of curiosity.</p>
      <p class="archive-count">{artifacts.length} objects in orbit</p>
    </header>
    <section aria-labelledby="archive-heading"><h2 id="archive-heading">Browse the archive</h2>{artifacts.slice(0, ARCHIVE_PAGE_SIZE).map((artifact) => <ArtifactCard {artifact} />)}<ArchivePagination basePath="/artifacts" {currentPage} {lastPage} /></section>
  </div>
</BaseLayout>
<style>
  .artifact-archive { max-width: var(--reading-width); padding-bottom: var(--section-space); }
  header { padding: var(--section-space) 0 var(--space-4); }
  .eyebrow, .archive-count { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); text-transform: uppercase; }
  .eyebrow { margin: 0 0 var(--space-2); }
  h1, h2 { font-family: var(--font-serif); font-weight: 500; line-height: var(--leading-tight); }
  h1 { font-size: clamp(2.5rem, 7vw, 5rem); letter-spacing: -.045em; margin: 0; }
  .lede { font-family: var(--font-serif); font-size: clamp(1.05rem, 2vw, 1.35rem); line-height: var(--leading-reading); margin: var(--space-2) 0 0; max-width: 39rem; }
  .archive-count { margin: var(--space-3) 0 0; }
  section { border-top: 1px solid var(--color-border); }
  h2 { font-size: var(--text-xl); margin: var(--space-3) 0 0; }
</style>
