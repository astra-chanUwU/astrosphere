---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArchivePageHeader from "../components/ArchivePageHeader.astro";
---

<BaseLayout title="Search" description="Search the AstroSphere archive." indexForSearch={false}>
  <div class="page-shell search-page" data-pagefind-search data-search-console>
    <section class="search-hero" aria-label="Search entry point">
      <ArchivePageHeader eyebrow="Archive discovery" title="Search" variant="search" summary="Find a way into the archive. Search across writing, manga, images, anime, links, and the ideas that connect them." />
    </section>

    <form class="search-console" role="search" onsubmit="return false">
      <label class="search-input"><span>Search the archive</span><span class="input-wrap"><input id="search-input" type="search" autocomplete="off" placeholder="Try “ghost”, “cyberpunk”, or “witch”…" data-search-input /><kbd>/</kbd></span></label>
      <section class="filters" aria-label="Search filters">
        <div class="filter-group"><p>Content type</p><div class="kind-filters" data-kind-filters><button type="button" data-kind="all" aria-pressed="true">all</button><button type="button" data-kind="essay" aria-pressed="false">essays</button><button type="button" data-kind="note" aria-pressed="false">notes</button><button type="button" data-kind="anime" aria-pressed="false">anime</button><button type="button" data-kind="manga" aria-pressed="false">manga</button><button type="button" data-kind="doujinshi" aria-pressed="false">doujinshi</button><button type="button" data-kind="image-set" aria-pressed="false">image sets</button><button type="button" data-kind="signals" aria-pressed="false">signals</button><button type="button" data-kind="sphere" aria-pressed="false">spheres</button><button type="button" data-kind="trail" aria-pressed="false">paths</button></div></div>
        <div class="filter-group sphere-filter"><p>Sphere</p><div class="sphere-options" data-sphere-options><button type="button" data-sphere="" aria-pressed="true">all topics</button></div></div>
        <div class="filter-group tag-filter"><p>Tags</p><label class="tag-search"><span class="visually-hidden">Search tags</span><input type="search" autocomplete="off" placeholder="Add a tag…" data-tag-search /></label><p class="tag-hint">Most used tags</p><div class="tag-options" data-tag-options></div><div class="selected-tags" data-selected-tags aria-live="polite"></div></div>
      </section>
      <button class="clear-filters" type="button" data-clear-filters hidden>Clear all filters</button>
    </form>

    <section class="search-suggestions" data-search-suggestions aria-labelledby="suggestions-heading">
      <p id="suggestions-heading">Try a search</p>
      <div>{["ghost", "cyberpunk", "witch", "Iran", "art history"].map((query) => <button type="button" data-query={query}>{query}</button>)}</div>
    </section>

    <section class="results-section" aria-labelledby="results-heading">
      <div class="section-heading"><h2 id="results-heading">Results</h2><p class="status" aria-live="polite" data-search-status>Loading the archive index…</p></div>
      <ol class="results" data-search-results></ol>
    </section>
  </div>
</BaseLayout>

<script>
  import "../scripts/pagefind-search";
</script>

<script is:inline type="module">
  try {
    const pagefind = await import("/pagefind/pagefind.js");
    window.__astrospherePagefind = pagefind;
  } catch (error) {
    window.__astrospherePagefindError = error;
  }
  window.dispatchEvent(new Event("astrosphere:pagefind-ready"));
</script>

<style>
  .search-page { max-width: 90rem; padding-bottom: var(--section-space); }
  .search-hero { align-items: end; border-bottom: 1px solid var(--color-border); display: grid; gap: clamp(2rem, 7vw, 8rem); grid-template-columns: minmax(0, 1.5fr) minmax(13rem, .7fr); padding: var(--section-space) 0 var(--space-5); }
  .search-hero :global(.archive-page-header) { padding: 0; }
  .search-console { background: var(--color-surface); border: 1px solid var(--color-border); margin-top: var(--space-5); padding: clamp(var(--space-3), 4vw, var(--space-5)); }
  .search-input { display: grid; gap: var(--space-1); }
  .search-input > span:first-child, .filters p, .filters label { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); text-transform: uppercase; }
  .visually-hidden { height: 1px; margin: -1px; overflow: hidden; position: absolute; width: 1px; clip: rect(0 0 0 0); }
  .input-wrap { display: flex; position: relative; }
  input { background: var(--color-bg); border: var(--border-width) solid var(--color-border); color: var(--color-text); font: inherit; min-height: 3.5rem; padding: .55rem .75rem; }
  input { font-size: clamp(1.1rem, 2.4vw, 1.45rem); padding-right: 3rem; width: 100%; }
  kbd { align-items: center; border: 1px solid var(--color-border); color: var(--color-muted); display: flex; font: var(--text-sm) var(--font-mono); height: 1.6rem; justify-content: center; position: absolute; right: .7rem; top: .95rem; width: 1.6rem; }
  .filters { align-items: end; border-top: 1px solid var(--color-border); display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-4); padding-top: var(--space-3); }
  .filter-group { flex: 1 1 100%; }
  .sphere-filter { border-top: 1px solid var(--color-border); padding-top: var(--space-3); }
  .tag-filter { border-top: 1px solid var(--color-border); padding-top: var(--space-3); }
  .filters > label, .tag-search { display: grid; gap: var(--space-1); min-width: 12rem; }
  .filters p { margin: 0 0 var(--space-1); }
  .kind-filters { display: flex; flex-wrap: wrap; gap: .35rem; }
  button { background: transparent; border: var(--border-width) solid var(--color-border); color: var(--color-text); cursor: pointer; font: inherit; min-height: 2.35rem; padding: .25rem .6rem; }
  button:hover, button[aria-pressed="true"] { background: var(--color-astral-blue); border-color: var(--color-astral-blue); color: #fff; }
  select { min-height: 2.35rem; padding-block: .25rem; }
  .sphere-options, .tag-options, .selected-tags { display: flex; flex-wrap: wrap; gap: .35rem; }
  .sphere-options button, .tag-options button, .selected-tags button { min-height: 2.2rem; }
  .tag-search input { min-height: 2.35rem; max-width: 26rem; }
  .tag-hint { margin-top: var(--space-3) !important; }
  .tag-options button { border-style: dashed; }
  .selected-tags { margin-top: var(--space-2); }
  .selected-tags button { background: var(--color-astral-blue); border-color: var(--color-astral-blue); color: #fff; }
  .clear-filters { border: 0; color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); margin-top: var(--space-3); padding-inline: 0; text-transform: uppercase; }
  .clear-filters:hover { background: transparent; color: var(--color-nebula-purple); }
  .search-suggestions { margin-top: var(--space-5); }
  .search-suggestions > p { color: var(--color-muted); font: var(--text-xs) var(--font-mono); letter-spacing: var(--label-tracking); margin: 0 0 var(--space-2); text-transform: uppercase; }
  .search-suggestions > div { display: flex; flex-wrap: wrap; gap: .45rem; }
  .search-suggestions button { border-style: dashed; }
  .section-heading { align-items: baseline; border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; padding-bottom: var(--space-2); }
  .section-heading h2 { font-size: var(--text-xl); margin: 0; }
  .results-section { margin-top: var(--space-6); }
  .results-section .status { color: var(--color-muted); font-size: var(--text-sm); margin: 0; }
  .results { display: grid; gap: var(--space-2); grid-template-columns: repeat(2, minmax(0, 1fr)); list-style: none; margin: var(--space-3) 0 0; padding: 0; }
  :global(.results li) { background: var(--color-surface); border: 1px solid var(--color-border); min-width: 0; padding: var(--space-3); }
  :global(.results a) { display: block; overflow-wrap: anywhere; text-decoration: none; }
  :global(.result-kind) { color: var(--color-accent); font: var(--text-xs) var(--font-mono); letter-spacing: var(--label-tracking); text-transform: uppercase; }
  :global(.result-title) { color: var(--color-text); display: block; font-size: var(--text-lg); font-weight: 600; margin-top: var(--space-1); }
  :global(.result-arrow) { color: var(--color-muted); float: right; font-size: 1.2rem; }
  :global(.results p) { color: var(--color-muted); display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; margin: var(--space-2) 0 0; overflow: hidden; overflow-wrap: anywhere; }
  @media (max-width: 48rem) { .search-hero { gap: var(--space-4); grid-template-columns: 1fr; } .results { grid-template-columns: 1fr; } .filters { align-items: stretch; } .filters > label { flex: 1 1 10rem; min-width: 0; } }
</style>
