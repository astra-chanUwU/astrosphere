---
import BaseLayout from "../layouts/BaseLayout.astro";
import { isConfiguredSupportValue, supportConfig, type SupportContact } from "../config/support";

const contactHref = (contact: SupportContact) =>
  contact.kind === "email" ? `mailto:${contact.value}` : contact.value;
const supporters = import.meta.env.DEV ? supportConfig.exampleSupporters : supportConfig.supporters;
const supportersTitle = import.meta.env.DEV ? "Example supporters — development only" : "Supporters";
---

<BaseLayout title="Support AstroSphere" description="Help Astro Chan keep this personal corner of the internet online.">
  <div class="page-shell">
    <header>
      <h1>Support AstroSphere</h1>
      <p>AstroSphere is a personal project I keep building in the spaces between everything else. If you have found something useful, strange, or worth returning to, you can help me keep the site online and give it more time. Crypto wallets and public contact routes are listed below.</p>
    </header>

    <section aria-labelledby="anonymous-heading">
      <h2 id="anonymous-heading">Give anonymously</h2>
      <p>Crypto support is welcome. No wallet connection, form, tracking, or identity is collected here.</p>
      <div class="wallets">
        {supportConfig.wallets.map((wallet) => (
          <article>
            <h3>{wallet.asset}</h3>
            <p class="network">{wallet.network}</p>
            {isConfiguredSupportValue(wallet.address) ? (
              <div class="wallet-address">
                <code>{wallet.address}</code>
                <button type="button" data-copy-wallet={wallet.address}>copy</button>
              </div>
            ) : <p class="unconfigured">Wallet address not configured yet.</p>}
          </article>
        ))}
      </div>
      <p class="warning">Always verify the network before sending. Never send seed phrases, private keys, or exchange login details.</p>
    </section>

    <section aria-labelledby="credit-heading">
      <h2 id="credit-heading">Want to be credited?</h2>
      <p>Send a message after donating if you want your name and amount listed. Public credit is opt-in; anonymous support stays anonymous.</p>
      <ul class="contacts">
        {supportConfig.contacts.filter((contact) => isConfiguredSupportValue(contact.value)).map((contact) => <li><a href={contactHref(contact)}>{contact.label}</a></li>)}
      </ul>
      {!supportConfig.contacts.some((contact) => isConfiguredSupportValue(contact.value)) && <p class="unconfigured">Contact details are not configured yet.</p>}
    </section>

    {supporters.length > 0 && <section aria-labelledby="supporters-heading"><h2 id="supporters-heading">{supportersTitle}</h2><ul class="supporters">{supporters.map((supporter) => <li><span>{supporter.name}</span><span>{supporter.amount}</span><time>{supporter.date}</time></li>)}</ul></section>}
  </div>
</BaseLayout>

<script>
  const bindCopyControls = () => {
    document.querySelectorAll<HTMLButtonElement>("[data-copy-wallet]").forEach((button) => {
      if (button.dataset.copyBound === "true") return;
      button.dataset.copyBound = "true";

      button.addEventListener("click", async () => {
        const label = button.textContent;
        const value = button.dataset.copyWallet;
        if (!value) return;

        try {
          await navigator.clipboard.writeText(value);
          button.textContent = "copied";
        } catch {
          button.textContent = "select address";
        }

        window.setTimeout(() => { button.textContent = label; }, 1400);
      });
    });
  };

  document.addEventListener("astro:page-load", bindCopyControls);
</script>

<style>
  header { max-width: var(--reading-width); padding: var(--section-space) 0 var(--space-4); }
  h1 { font-family: var(--font-serif); font-size: var(--text-2xl); font-weight: 500; margin: 0; }
  h2 { font-size: var(--text-xl); margin: 0 0 var(--space-2); }
  h3 { font-size: var(--text-lg); margin: 0; }
  section { margin: var(--section-space) 0; max-width: var(--reading-width); }
  p { font-family: var(--font-serif); font-size: var(--text-lg); line-height: var(--leading-reading); }
  .wallets { display: grid; gap: var(--space-2); grid-template-columns: 1fr; }
  article { border-top: 1px solid var(--color-border); padding-top: var(--space-2); }
  .network, .warning, .unconfigured { color: var(--color-muted); font-family: inherit; font-size: var(--text-sm); }
  .wallet-address { display: flex; align-items: start; gap: var(--space-1); }
  code { flex: 1; font-size: var(--text-sm); overflow-wrap: anywhere; user-select: all; }
  button { background: transparent; border: 1px solid var(--color-border); color: var(--color-text); cursor: pointer; font: inherit; font-size: var(--text-sm); padding: 0.15rem 0.45rem; }
  button:hover, button:focus-visible { border-color: var(--color-link); color: var(--color-link); }
  .contacts, .supporters { list-style: none; margin: 0; padding: 0; }
  .contacts { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .supporters li { border-top: 1px solid var(--color-border); display: grid; gap: var(--space-2); grid-template-columns: 1fr auto auto; padding: var(--space-1) 0; }
  time { color: var(--color-muted); font-size: var(--text-sm); }
</style>
