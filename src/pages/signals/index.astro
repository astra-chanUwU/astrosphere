---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SignalCard from "../../components/SignalCard.astro";
import FieldGuideRail from "../../components/FieldGuideRail.astro";
import { getPublishedSignals } from "../../lib/content";

const signals = await getPublishedSignals();
const sections = [
  { id: "manga", title: "Manga" },
  { id: "art-imageboards", title: "Art & Imageboards" },
  { id: "hentai-reading", title: "Hentai Reading" },
  { id: "anime", title: "Anime" },
  { id: "anime-physical", title: "Anime & Physical" },
  { id: "community", title: "Community" },
] as const;
---

<BaseLayout title="Signals" description="Websites worth returning to." pagefindFilters={[{ name: "kind", value: "signals" }, ...signals.flatMap((signal) => signal.data.tags.map((value) => ({ name: "tag", value }))), ...signals.flatMap((signal) => signal.data.spheres.map((value) => ({ name: "sphere", value })))]}>
  <div class="page-shell signals-page">
    <header><p class="eyebrow">External references</p><h1>Signals</h1><p>{signals.length} websites, archives, and reading rooms.</p></header>
    <div class="field-guide-grid"><main>{sections.map((section) => {
      const entries = signals.filter((signal) => signal.data.category === section.id);
      return entries.length > 0 && <section aria-labelledby={`${section.id}-heading`}><h2 id={`${section.id}-heading`}>{section.title}</h2>{entries.map((signal) => <SignalCard {signal} />)}</section>;
    })}</main><FieldGuideRail active="signals" /></div>
  </div>
</BaseLayout>

<style>
  .signals-page { max-width: 96rem; }
  header { padding: var(--section-space) 0 var(--section-space); }
  .eyebrow { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); text-transform: uppercase; }
  h1, h2 { font-family: var(--font-serif); font-weight: 500; line-height: var(--leading-tight); }
  h1 { font-size: clamp(2.5rem, 7vw, 5rem); letter-spacing: -.045em; margin: 0; }
  header > p:last-child { font-family: var(--font-serif); font-size: var(--text-lg); line-height: var(--leading-reading); margin: var(--space-1) 0 0; }
  .field-guide-grid { align-items: start; display: grid; gap: clamp(3rem, 7vw, 8rem); grid-template-columns: minmax(0, 1.5fr) minmax(16rem, .75fr); }
  section { margin: 0 0 var(--section-space); }
  h2 { border-bottom: 1px solid var(--color-border); font-size: var(--text-xl); margin: 0; padding-bottom: var(--space-2); }
  @media (max-width: 52rem) { .field-guide-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
