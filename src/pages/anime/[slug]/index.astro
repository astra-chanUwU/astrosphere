---
import AnimeEpisodeList from "../../../components/AnimeEpisodeList.astro";
import AnimeMeta from "../../../components/AnimeMeta.astro";
import AnimePlayer from "../../../components/AnimePlayer.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import type { SidebarModel } from "../../../config/navigation";
import { getAnimeVideoVariant, getAnimeVideosForTitle, getPublishedAnimeTitles, type AnimeTitleEntry } from "../../../lib/content";
import { getAnimeTitlePresentation } from "../../../lib/anime-presentation";

export async function getStaticPaths() {
  return (await getPublishedAnimeTitles()).map((title) => ({
    params: { slug: title.data.slug },
    props: { title },
  }));
}

interface Props { title: AnimeTitleEntry; }
const { title } = Astro.props;
const videos = await getAnimeVideosForTitle(title.data.slug);
const movie = title.data.kind === "movie" ? videos.find((video) => video.data.kind === "movie") : undefined;
const movieVariant = movie ? getAnimeVideoVariant(movie) : undefined;
const presentation = getAnimeTitlePresentation(title.data.kind, title.data.slug, videos);
const heroArt = title.data.art[0] ?? title.data.poster;
const supportingArt = title.data.art.slice(heroArt === title.data.art[0] ? 1 : 0);
const sidebar: SidebarModel = {
  heading: "Anime library",
  groups: [
    { items: [{ href: "/anime", label: "All anime" }] },
    ...(title.data.kind === "series" ? [{ label: "Episodes", items: videos.map((video) => ({ href: `/anime/${title.data.slug}/${video.data.slug}`, label: video.data.kind === "episode" ? `${video.data.number}. ${video.data.title}` : video.data.title })) }] : []),
    { label: "Tags", items: title.data.tags.map((tag) => ({ href: `/tags/${tag}`, label: `#${tag}` })) },
  ],
};
---

<BaseLayout title={title.data.title} description={title.data.description} image={title.data.poster?.src} sidebar={sidebar} pagefindFilters={[{ name: "kind", value: "anime" }, { name: "rating", value: title.data.rating }, ...title.data.tags.map((value) => ({ name: "tag", value }))]}>
  <div class="page-shell title-page" data-anime-rating={title.data.rating}>
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Anime", href: "/anime" }, { label: title.data.title }]} />
    <header class="anime-hero">
      {heroArt && <img class="hero-art" src={heroArt.src} alt="" fetchpriority="high" decoding="async" />}
      <div class="hero-content">
        {title.data.poster && <img class="hero-poster" src={title.data.poster.src} alt={title.data.poster.alt} fetchpriority="high" decoding="async" />}
        <div class="hero-copy">
          <p class="eyebrow">{title.data.format.replaceAll("-", " ")} · {title.data.releaseYear} · {title.data.studios.join(", ")}</p>
          <p class="original">{title.data.originalTitle}</p>
          <h1>{title.data.title}</h1>
          <p class="description">{title.data.description}</p>
          <p class="availability"><span>{presentation.itemCountLabel}</span><span>{presentation.variantCountLabel}</span><span>WebM only</span></p>
          <a class="start-watching" href={presentation.startHref}>{presentation.startLabel} <span aria-hidden="true">▶</span></a>
        </div>
      </div>
    </header>
    <div class="title-layout">
      <div class="title-primary">
        {title.data.kind === "movie" && movie && movieVariant
          ? <div class="movie-player" id="watch"><AnimePlayer {title} video={movie} variant={movieVariant} embeddedMovie /></div>
          : <AnimeEpisodeList {title} {videos} />}
      </div>
      <aside class="title-meta" aria-label={`${title.data.title} details`}><AnimeMeta {title} /></aside>
    </div>
    {supportingArt.length > 0 && <section class="art" aria-labelledby="anime-art-heading"><h2 id="anime-art-heading">Artwork</h2>{supportingArt.map((item) => <figure><img src={item.src} alt={item.alt} loading="lazy" decoding="async" />{item.caption && <figcaption>{item.caption}</figcaption>}</figure>)}</section>}
  </div>
</BaseLayout>

<style>
  .title-page { max-width: 80rem; padding-bottom: var(--section-space); }
  .anime-hero { background: #081018; border: 1px solid var(--color-border); color: #fff; min-height: 26rem; overflow: hidden; position: relative; }
  .hero-art { height: 100%; inset: 0; object-fit: cover; opacity: .55; position: absolute; width: 100%; }
  .anime-hero::after { background: linear-gradient(90deg, rgba(0,0,0,.94) 0%, rgba(0,0,0,.76) 45%, rgba(0,0,0,.2) 100%), linear-gradient(0deg, rgba(0,0,0,.65), transparent 55%); content: ""; inset: 0; position: absolute; }
  .hero-content { align-items: end; display: grid; gap: clamp(1rem, 3vw, 2.5rem); grid-template-columns: minmax(8rem, 12rem) minmax(0, 40rem); min-height: 26rem; padding: clamp(1rem, 4vw, 3rem); position: relative; z-index: 1; }
  .hero-poster { border: 1px solid rgba(255,255,255,.55); box-shadow: 0 1.25rem 3rem rgba(0,0,0,.45); height: auto; width: 100%; }
  .hero-copy { padding-bottom: var(--space-1); }
  .eyebrow { color: #a9dfff; font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); margin: 0 0 var(--space-2); text-transform: uppercase; }
  .original { color: rgba(255,255,255,.74); margin: 0; }
  h1 { font-size: clamp(2.35rem, 6vw, 5.25rem); letter-spacing: -.05em; line-height: .95; margin: var(--space-1) 0 var(--space-3); }
  .description { font-size: var(--text-lg); line-height: var(--leading-reading); margin: 0; max-width: 38rem; }
  .availability { display: flex; flex-wrap: wrap; gap: .4rem; margin: var(--space-3) 0; }
  .availability span { border: 1px solid rgba(255,255,255,.45); font-family: var(--font-mono); font-size: var(--text-xs); padding: .3rem .45rem; }
  .start-watching { background: #fff; color: #061018; display: inline-block; font-weight: 600; padding: .75rem 1rem; text-decoration: none; }
  .start-watching:hover { background: var(--color-astral-blue); color: #fff; }
  .title-layout { align-items: start; display: grid; gap: clamp(2rem, 5vw, 4rem); grid-template-columns: minmax(0, 1.65fr) minmax(15rem, .7fr); }
  .title-primary { min-width: 0; }
  .title-meta { align-self: start; position: sticky; top: var(--space-3); }
  .movie-player { scroll-margin-top: var(--space-3); }
  .movie-player, .art { margin-top: var(--section-space); }
  .art { border-top: 1px solid var(--color-border); }
  .art h2 { font-family: var(--font-serif); font-size: var(--text-xl); font-weight: 500; }
  figure { margin: var(--space-3) 0; max-width: 60rem; }
  figure img { height: auto; width: 100%; }
  figcaption { color: var(--color-muted); font-size: var(--text-sm); }
  @media (max-width: 64rem) { .title-layout { grid-template-columns: minmax(0, 1fr); } .title-meta { max-width: var(--reading-width); position: static; } }
  @media (max-width: 38rem) { .hero-content { align-items: end; grid-template-columns: 6.5rem minmax(0, 1fr); min-height: 30rem; padding: var(--space-3); } h1 { font-size: clamp(2rem, 10vw, 3.3rem); } .description { grid-column: 1 / -1; } .anime-hero::after { background: linear-gradient(0deg, rgba(0,0,0,.96) 0%, rgba(0,0,0,.82) 62%, rgba(0,0,0,.25) 100%); } }
  @media (max-width: 28rem) { .hero-content { display: block; padding-top: 8rem; } .hero-poster { margin-bottom: var(--space-3); width: 6rem; } }
</style>
