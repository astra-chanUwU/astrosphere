---
import ShelfArchive from "../../components/ShelfArchive.astro";
import ArchivePageHeader from "../../components/ArchivePageHeader.astro";
import ArchiveRail from "../../components/ArchiveRail.astro";
import { SHELF_PAGE_SIZE } from "../../config/shelf";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedMangaChapters } from "../../lib/content";
import { getShelfArchive } from "../../lib/shelf";

const [entries, chapters] = await Promise.all([getShelfArchive("doujinshi"), getPublishedMangaChapters()]);
const chapterCountBySeriesSlug = new Map<string, number>();
for (const chapter of chapters) chapterCountBySeriesSlug.set(chapter.data.series, (chapterCountBySeriesSlug.get(chapter.data.series) ?? 0) + 1);
const currentPage = 1;
const lastPage = Math.ceil(entries.length / SHELF_PAGE_SIZE);
---

<BaseLayout title="Doujinshi" description="The doujinshi archive.">
  <div class="page-shell">
    <ArchivePageHeader eyebrow="Short books and fanworks" title="Doujinshi" variant="doujinshi" summary="Published doujinshi in the archive." />
    <div class="archive-layout"><ShelfArchive category="doujinshi" entries={entries.slice(0, SHELF_PAGE_SIZE)} {currentPage} {lastPage} {chapterCountBySeriesSlug} basePath="/doujinshi" /><ArchiveRail active="doujinshi" /></div>
  </div>
</BaseLayout>

<style>
  .archive-layout { align-items: start; display: grid; gap: clamp(2rem, 4cqi, 4rem); grid-template-columns: minmax(0, 2fr) minmax(13rem, .8fr); }
  @container content (max-width: 48rem) { .archive-layout { grid-template-columns: minmax(0, 1fr); } }
</style>
