---
import type { GetStaticPaths } from "astro";
import ShelfArchive from "../../../components/ShelfArchive.astro";
import ArchiveRail from "../../../components/ArchiveRail.astro";
import { SHELF_PAGE_SIZE } from "../../../config/shelf";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getPublishedMangaChapters } from "../../../lib/content";
import { getShelfArchive } from "../../../lib/shelf";

export const getStaticPaths = (async ({ paginate }) => paginate(await getShelfArchive("doujinshi"), { pageSize: SHELF_PAGE_SIZE }).filter((path) => Number(path.params.page) > 1)) satisfies GetStaticPaths;
const { page } = Astro.props;
const chapters = await getPublishedMangaChapters();
const chapterCountBySeriesSlug = new Map<string, number>();
for (const chapter of chapters) chapterCountBySeriesSlug.set(chapter.data.series, (chapterCountBySeriesSlug.get(chapter.data.series) ?? 0) + 1);
---
<BaseLayout title={`Doujinshi — page ${page.currentPage}`} description="The doujinshi archive."><div class="page-shell"><header><p class="eyebrow">Short books and fanworks</p><h1>Doujinshi</h1><p>Published doujinshi in the archive.</p></header><div class="archive-layout"><ShelfArchive category="doujinshi" entries={page.data} currentPage={page.currentPage} lastPage={page.lastPage} {chapterCountBySeriesSlug} basePath="/doujinshi" /><ArchiveRail active="doujinshi" /></div></div></BaseLayout>
<style>header{max-width:var(--reading-width);padding:var(--section-space) 0 var(--space-4)}.eyebrow{color:var(--color-muted);font-family:var(--font-mono);font-size:var(--text-xs);letter-spacing:var(--label-tracking);text-transform:uppercase}h1{font-family:var(--font-serif);font-size:var(--text-2xl);font-weight:500;margin:var(--space-1) 0}header p:last-child{font-family:var(--font-serif);font-size:var(--text-lg);line-height:var(--leading-reading)}.archive-layout{align-items:start;display:grid;gap:clamp(2rem,6vw,6rem);grid-template-columns:minmax(0,2fr) minmax(13rem,1fr)}@media(max-width:48rem){.archive-layout{grid-template-columns:minmax(0,1fr)}}</style>
