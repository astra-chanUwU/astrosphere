---
import MangaChapterList from "../../components/MangaChapterList.astro";
import MangaContentWarning from "../../components/MangaContentWarning.astro";
import MangaArtGallery from "../../components/MangaArtGallery.astro";
import DoujinshiPagePreview from "../../components/DoujinshiPagePreview.astro";
import MangaSeriesMeta from "../../components/MangaSeriesMeta.astro";
import MangaSeriesNavigator from "../../components/MangaSeriesNavigator.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { SidebarModel } from "../../config/navigation";
import { getMangaChaptersForSeries, getPublishedMangaSeries, type MangaSeriesEntry } from "../../lib/content";
import { belongsToMangaPublicRoute, getMangaPublicPath } from "../../lib/manga-reader";

export async function getStaticPaths() {
  const series = await getPublishedMangaSeries();
  return series
    .filter((entry) => belongsToMangaPublicRoute(entry.data.format, "doujinshi"))
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { series: entry } }));
}

interface Props { series: MangaSeriesEntry; }
const { series } = Astro.props;
const [chapters, allSeries] = await Promise.all([getMangaChaptersForSeries(series.data.slug), getPublishedMangaSeries()]);
const recommendations = allSeries
  .filter((candidate) => candidate.data.slug !== series.data.slug && belongsToMangaPublicRoute(candidate.data.format, "doujinshi"))
  .map((candidate) => {
    const sharedTags = candidate.data.tags.filter((tag) => series.data.tags.includes(tag)).length;
    const sharedAuthor = candidate.data.authors.some((person) => series.data.authors.some((author) => author.slug === person.slug));
    const sharedArtist = candidate.data.artists.some((person) => series.data.artists.some((artist) => artist.slug === person.slug));
    return { candidate, score: sharedTags * 3 + (sharedAuthor ? 2 : 0) + (sharedArtist ? 2 : 0) };
  })
  .filter(({ score }) => score > 0)
  .sort((left, right) => right.score - left.score || left.candidate.data.title.localeCompare(right.candidate.data.title))
  .slice(0, 5)
  .map(({ candidate }) => candidate);
const creators = [
  ...series.data.authors.map((person) => ({ ...person, role: "Author" })),
  ...series.data.artists.map((person) => ({ ...person, role: "Artist" })),
];
const sidebar: SidebarModel = {
  heading: "Doujinshi library",
  groups: [
    { items: [{ href: "/doujinshi", label: "All doujinshi" }] },
    ...(recommendations.length ? [{ label: "Similar doujinshi", items: recommendations.map((entry) => ({ href: getMangaPublicPath(entry.data.format, entry.data.slug), label: entry.data.title })) }] : []),
    { label: "Tags", items: series.data.tags.map((tag) => ({ href: `/tags/${tag}`, label: `#${tag}` })) },
    { label: "Creators", items: creators.map((person) => ({ href: `/manga/creators/${person.slug}`, label: `${person.role}: ${person.name}` })) },
  ],
};
---

<BaseLayout title={series.data.title} description={series.data.description} sidebar={sidebar} readerDock pagefindFilters={[{ name: "kind", value: "doujinshi" }, { name: "rating", value: series.data.rating }, ...series.data.tags.map((value) => ({ name: "tag", value }))]}><MangaContentWarning rating={series.data.rating}><div class="page-shell series-layout"><div><header class="series-intro">{series.data.cover && <img src={series.data.cover.src} alt={series.data.cover.alt ?? `${series.data.title} cover`} fetchpriority="high" decoding="async" />}<div><p class="original">{series.data.originalTitle}</p><h1>{series.data.title}</h1></div></header><MangaSeriesMeta {series} /><MangaChapterList {series} {chapters} /><DoujinshiPagePreview {series} {chapters} /><MangaArtGallery art={series.data.art} /></div><MangaSeriesNavigator {series} {chapters} art={series.data.art} /></div></MangaContentWarning></BaseLayout>

<style>.series-layout { align-items: start; display: grid; gap: clamp(2rem, 6vw, 6rem); grid-template-columns: minmax(0, var(--reading-width)) minmax(13rem, 16rem); max-width: calc(var(--reading-width) + 22rem); } .series-intro { align-items: start; display: grid; gap: var(--space-2); grid-template-columns: minmax(7rem, 8rem) 1fr; max-width: var(--reading-width); padding-top: var(--section-space); } .series-intro img { height: auto; max-width: 8rem; width: 100%; } .original { color: var(--color-muted); font-size: var(--text-sm); margin: 0; } h1 { font-size: var(--text-2xl); margin: var(--space-1) 0; } @media (max-width: 52rem) { .series-layout { grid-template-columns: minmax(0, 1fr); } } @media (max-width: 30rem) { .series-intro { grid-template-columns: 6rem 1fr; } .series-intro img { max-width: 6rem; } }</style>
