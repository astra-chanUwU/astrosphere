---
import type { GetStaticPaths } from "astro";
import ShelfArchive from "../../../components/ShelfArchive.astro";
import { SHELF_PAGE_SIZE } from "../../../config/shelf";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getPublishedMangaChapters } from "../../../lib/content";
import { getShelfArchive } from "../../../lib/shelf";

export const getStaticPaths = (async ({ paginate }) => paginate(await getShelfArchive("manga"), { pageSize: SHELF_PAGE_SIZE }).filter((path) => Number(path.params.page) > 1)) satisfies GetStaticPaths;
const { page } = Astro.props;
const chapters = await getPublishedMangaChapters();
const chapterCountBySeriesSlug = new Map<string, number>();
for (const chapter of chapters) chapterCountBySeriesSlug.set(chapter.data.series, (chapterCountBySeriesSlug.get(chapter.data.series) ?? 0) + 1);
---
<BaseLayout title={`Manga — page ${page.currentPage}`} description="The manga archive."><div class="page-shell"><header><p class="eyebrow">Sequential work</p><h1>Manga</h1><p>Published manga in the archive.</p></header><ShelfArchive category="manga" entries={page.data} currentPage={page.currentPage} lastPage={page.lastPage} {chapterCountBySeriesSlug} basePath="/manga" /></div></BaseLayout>
<style>header{max-width:var(--reading-width);padding:var(--section-space) 0 var(--space-4)}.eyebrow{color:var(--color-muted);font-family:var(--font-mono);font-size:var(--text-xs);letter-spacing:var(--label-tracking);text-transform:uppercase}h1{font-family:var(--font-serif);font-size:var(--text-2xl);font-weight:500;margin:var(--space-1) 0}header p:last-child{font-family:var(--font-serif);font-size:var(--text-lg);line-height:var(--leading-reading)}</style>
