---
import MangaSeriesCard from "../../../components/MangaSeriesCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getPublishedMangaChapters, getPublishedMangaSeries } from "../../../lib/content";
import { getMangaCreators, type MangaCreator } from "../../../lib/manga-creators";

export async function getStaticPaths() {
  const creators = getMangaCreators(await getPublishedMangaSeries());
  return creators.map((creator) => ({ params: { slug: creator.slug }, props: { creator } }));
}

interface Props { creator: MangaCreator; }
const { creator } = Astro.props;
const [allSeries, chapters] = await Promise.all([getPublishedMangaSeries(), getPublishedMangaChapters()]);
const series = allSeries.filter((entry) => entry.data.authors.some((person) => person.slug === creator.slug) || entry.data.artists.some((person) => person.slug === creator.slug));
const chapterCounts = new Map<string, number>();
for (const chapter of chapters) chapterCounts.set(chapter.data.series, (chapterCounts.get(chapter.data.series) ?? 0) + 1);
---

<BaseLayout title={creator.name} description={`Manga by ${creator.name}.`}><div class="page-shell"><header><p class="eyebrow">Manga creator</p><h1>{creator.name}</h1><p>{series.length} {series.length === 1 ? "series" : "series"} in the archive.</p></header><section aria-labelledby="creator-series-heading"><h2 id="creator-series-heading">Manga</h2>{series.map((entry) => <MangaSeriesCard series={entry} chapterCount={chapterCounts.get(entry.data.slug) ?? 0} />)}</section></div></BaseLayout>

<style>header{max-width:var(--reading-width);padding:var(--section-space) 0 var(--space-4)}.eyebrow{color:var(--color-accent);font-size:var(--text-xs);letter-spacing:.1em;margin:0;text-transform:uppercase}h1{font-family:var(--font-serif);font-size:var(--text-2xl);font-weight:500;margin:var(--space-1) 0}header p:last-child{font-family:var(--font-serif);font-size:var(--text-lg);line-height:var(--leading-reading)}section{max-width:var(--reading-width)}h2{font-family:var(--font-serif);font-size:var(--text-xl);font-weight:500;margin:0}</style>
