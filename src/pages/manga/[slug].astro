---
import MangaChapterList from "../../components/MangaChapterList.astro";
import MangaContentWarning from "../../components/MangaContentWarning.astro";
import MangaArtGallery from "../../components/MangaArtGallery.astro";
import MangaSeriesMeta from "../../components/MangaSeriesMeta.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { SidebarModel } from "../../config/navigation";
import { getMangaChaptersForSeries, getPublishedMangaSeries, type MangaSeriesEntry } from "../../lib/content";

export async function getStaticPaths() {
  const series = await getPublishedMangaSeries();
  return series.map((entry) => ({ params: { slug: entry.data.slug }, props: { series: entry } }));
}

interface Props { series: MangaSeriesEntry; }
const { series } = Astro.props;
const chapters = await getMangaChaptersForSeries(series.data.slug);
const sidebar: SidebarModel = {
  heading: "Manga library",
  groups: [
    { items: [{ href: "/shelf/manga", label: "All manga" }] },
    { label: "Chapters", items: chapters.map((entry) => ({ href: `/manga/${series.data.slug}/${entry.data.slug}`, label: `Chapter ${entry.data.number}` })) },
  ],
};
---

<BaseLayout title={series.data.title} description={series.data.description} sidebar={sidebar} pagefindFilters={[{ name: "kind", value: "manga" }, { name: "rating", value: series.data.rating }, ...series.data.tags.map((value) => ({ name: "tag", value }))]}><MangaContentWarning rating={series.data.rating}><div class="page-shell"><header class="series-intro">{series.data.cover && <img src={series.data.cover.src} alt={series.data.cover.alt ?? `${series.data.title} cover`} fetchpriority="high" decoding="async" />}<div><p class="original">{series.data.originalTitle}</p><h1>{series.data.title}</h1></div></header><MangaSeriesMeta {series} /><MangaChapterList {series} {chapters} /><MangaArtGallery art={series.data.art} /></div></MangaContentWarning></BaseLayout>

<style>.series-intro { align-items: start; display: grid; gap: var(--space-2); grid-template-columns: minmax(7rem, 10rem) 1fr; max-width: var(--reading-width); padding-top: var(--section-space); } .series-intro img { height: auto; width: 100%; } .original { color: var(--color-muted); font-size: var(--text-sm); margin: 0; } h1 { font-size: var(--text-2xl); margin: var(--space-1) 0; } @media (max-width: 30rem) { .series-intro { grid-template-columns: 7rem 1fr; } }</style>
