---
import ImageSetCard from "../components/ImageSetCard.astro";
import AnimeCard from "../components/AnimeCard.astro";
import MangaSeriesCard from "../components/MangaSeriesCard.astro";
import PageGlyph from "../components/PageGlyph.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  assertPublishingGuardrails,
  getPublishedArtifacts,
  getPublishedAnimeVideos,
  getPublishedImageSets,
  getPublishedMangaChapters,
  getPublishedMangaSeries,
  getPublishedTrails,
} from "../lib/content";
import { getShelfSelections } from "../lib/shelf";
import { createMangaCoverPreviewSrc, getMangaPublicPath } from "../lib/manga-reader";
import { createManagedImageThumbnailSrc } from "../lib/managed-image-thumbnails";

if (import.meta.env.PROD) await assertPublishingGuardrails();

const [artifacts, imageSets, mangaSeries, chapters, trails, shelf, animeVideos] = await Promise.all([
  getPublishedArtifacts(),
  getPublishedImageSets(),
  getPublishedMangaSeries(),
  getPublishedMangaChapters(),
  getPublishedTrails(),
  getShelfSelections(),
  getPublishedAnimeVideos(),
]);

const animeVideosByTitle = new Map<string, typeof animeVideos>();
for (const video of animeVideos) animeVideosByTitle.set(video.data.anime, [...(animeVideosByTitle.get(video.data.anime) ?? []), video]);

const chapterCountBySeriesSlug = new Map<string, number>();
const seriesBySlug = new Map(mangaSeries.map((series) => [series.data.slug, series]));
for (const chapter of chapters) {
  chapterCountBySeriesSlug.set(chapter.data.series, (chapterCountBySeriesSlug.get(chapter.data.series) ?? 0) + 1);
}

type Dispatch =
  | { kind: "artifact"; date: Date; item: (typeof artifacts)[number] }
  | { kind: "image-set"; date: Date; item: (typeof imageSets)[number] }
  | { kind: "chapter"; date: Date; item: (typeof chapters)[number]; seriesTitle: string }
  | { kind: "trail"; date: Date; item: (typeof trails)[number] };

const dispatches: Dispatch[] = [
  ...artifacts.map((item) => ({ kind: "artifact" as const, date: item.data.updatedAt ?? item.data.publishedAt, item })),
  ...imageSets.map((item) => ({ kind: "image-set" as const, date: item.data.updatedAt ?? item.data.publishedAt, item })),
  ...chapters.flatMap((item) => item.data.publishedAt ? [{ kind: "chapter" as const, date: item.data.publishedAt, item, seriesTitle: seriesBySlug.get(item.data.series)?.data.title ?? item.data.series }] : []),
  ...trails.flatMap((item) => item.data.updatedAt ? [{ kind: "trail" as const, date: item.data.updatedAt, item }] : []),
].sort((left, right) => right.date.getTime() - left.date.getTime()).slice(0, 12);

type DispatchGroup = { date: Date; items: Dispatch[] };
const dispatchGroups: DispatchGroup[] = [];
for (const dispatch of dispatches) {
  const currentGroup = dispatchGroups.at(-1);
  if (currentGroup && currentGroup.date.toDateString() === dispatch.date.toDateString()) currentGroup.items.push(dispatch);
  else dispatchGroups.push({ date: dispatch.date, items: [dispatch] });
}

const dispatchTitleLimit = 72;
const truncateDispatchTitle = (title: string): string => {
  const characters = Array.from(title);
  return characters.length > dispatchTitleLimit
    ? `${characters.slice(0, dispatchTitleLimit - 1).join("").trimEnd()}…`
    : title;
};

const newestImageSets = imageSets.slice(0, 5);
const recommendedManga = shelf.manga.slice(0, 5);
const recommendedDoujinshi = shelf.doujinshi.slice(0, 5);
const currentManga = recommendedManga[0];
const currentImageSet = newestImageSets[0];
const currentDoujinshi = recommendedDoujinshi[0];
const currentAnime = shelf.anime[0];
---

<BaseLayout title="AstroSphere" description="An independent archive of manga, image sets, doujinshi, artifacts, and connected paths.">
  <div class="page-shell home">
    <div class="archive-columns">
      <aside class="recommendations">
        <section class="current-attention" aria-labelledby="current-attention-title"><div class="feed-heading"><h2 id="current-attention-title">Now</h2><a href="/about">About →</a></div>{currentManga && <article class="current-feature" data-manga-rating={currentManga.data.rating}><a class="current-feature-cover" href={getMangaPublicPath(currentManga.data.format, currentManga.data.slug)}>{currentManga.data.cover && <img src={createMangaCoverPreviewSrc(currentManga.data.format, currentManga.data.slug, currentManga.data.cover.src)} alt={currentManga.data.cover.alt ?? `${currentManga.data.title} cover`} loading="eager" decoding="async" />}</a><div><p class="current-label">Read next</p><h3><a href={getMangaPublicPath(currentManga.data.format, currentManga.data.slug)}>{currentManga.data.title}</a></h3><p class="current-meta">{currentManga.data.originalTitle}</p></div></article>}{(currentImageSet || currentDoujinshi) && <ul class="current-secondary">{currentImageSet && <li><span>Recent set</span><a href={`/image-sets/${currentImageSet.data.slug}`}>{currentImageSet.data.title}</a></li>}{currentDoujinshi && <li data-manga-rating={currentDoujinshi.data.rating}><span>Adult shelf</span><a href={getMangaPublicPath(currentDoujinshi.data.format, currentDoujinshi.data.slug)}>{currentDoujinshi.data.title}</a></li>}</ul>}</section>
        {currentAnime && <section class="anime-home" aria-labelledby="anime-home-title"><div class="feed-heading"><div><p class="current-label">Native WebM cinema</p><h2 id="anime-home-title">Watch anime</h2></div><a href="/anime">All →</a></div><div class="anime-home-grid"><AnimeCard title={currentAnime} videos={animeVideosByTitle.get(currentAnime.data.slug) ?? []} /></div></section>}
        <section aria-labelledby="manga-recommendations-title"><div class="feed-heading"><h2 id="manga-recommendations-title">Read next</h2><a href="/manga">All →</a></div><div class="recommendation-list">{recommendedManga.map((series) => <MangaSeriesCard {series} chapterCount={chapterCountBySeriesSlug.get(series.data.slug) ?? 0} />)}</div></section>
        <section aria-labelledby="image-set-recommendations-title"><div class="feed-heading"><h2 id="image-set-recommendations-title">Recent sets</h2><a href="/image-sets">All →</a></div><div class="recommendation-list">{newestImageSets.map((imageSet) => <ImageSetCard {imageSet} />)}</div></section>
        <section aria-labelledby="doujinshi-recommendations-title"><div class="feed-heading"><h2 id="doujinshi-recommendations-title">Doujinshi</h2><a href="/doujinshi">All →</a></div><div class="recommendation-list">{recommendedDoujinshi.map((series) => <MangaSeriesCard {series} chapterCount={chapterCountBySeriesSlug.get(series.data.slug) ?? 0} />)}</div></section>
      </aside>

      <main class="dispatches" aria-labelledby="dispatches-title">
        <header class="dispatch-header"><PageGlyph label="Dispatches" variant="dispatches" headingLevel={2} /></header>
        <div class="dispatch-list">
          {dispatchGroups.map((group) => <section class="dispatch-group" aria-labelledby={`dispatch-date-${group.date.toISOString().slice(0, 10)}`}>
            <h3 class="dispatch-date" id={`dispatch-date-${group.date.toISOString().slice(0, 10)}`}><time datetime={group.date.toISOString()}>{group.date.toLocaleDateString("en", { year: "numeric", month: "short", day: "numeric" })}</time></h3>
            {group.items.map((dispatch) => <article class="dispatch-item">
              {dispatch.kind === "artifact" && <div class:list={["dispatch-entry", { "dispatch-entry--artifact": dispatch.item.data.hero?.kind === "image" }]}>{dispatch.item.data.hero?.kind === "image" && <a class="dispatch-thumb" href={`/articles/${dispatch.item.data.slug}`}><img src={createManagedImageThumbnailSrc(dispatch.item.data.hero.src)} alt={dispatch.item.data.hero.alt ?? dispatch.item.data.title} loading="lazy" decoding="async" /></a>}<div class="dispatch-copy"><p class="dispatch-type">{dispatch.item.data.type.replace("-", " ")}</p><h4><a href={`/articles/${dispatch.item.data.slug}`} aria-label={dispatch.item.data.title} title={dispatch.item.data.title}>{truncateDispatchTitle(dispatch.item.data.title)}</a></h4><p>{dispatch.item.data.summary}</p></div></div>}
              {dispatch.kind === "image-set" && <div class="dispatch-entry"><div class="dispatch-copy"><p class="dispatch-type">Image set</p><h4><a href={`/image-sets/${dispatch.item.data.slug}`} aria-label={dispatch.item.data.title} title={dispatch.item.data.title}>{truncateDispatchTitle(dispatch.item.data.title)}</a></h4><p>{dispatch.item.data.summary}</p></div></div>}
              {dispatch.kind === "chapter" && <div class="dispatch-entry"><div class="dispatch-copy"><p class="dispatch-type">Chapter</p><h4><a href={`/manga/${dispatch.item.data.series}/${dispatch.item.data.slug}`} aria-label={`${dispatch.seriesTitle} — ${dispatch.item.data.title}`} title={`${dispatch.seriesTitle} — ${dispatch.item.data.title}`}>{truncateDispatchTitle(`${dispatch.seriesTitle} — ${dispatch.item.data.title}`)}</a></h4><p>Chapter {dispatch.item.data.number}</p></div></div>}
              {dispatch.kind === "trail" && <div class="dispatch-entry"><div class="dispatch-copy"><p class="dispatch-type">Path</p><h4><a href={`/paths/${dispatch.item.data.slug}`} aria-label={dispatch.item.data.title} title={dispatch.item.data.title}>{truncateDispatchTitle(dispatch.item.data.title)}</a></h4><p>{dispatch.item.data.summary}</p></div></div>}
            </article>)}
          </section>)}
        </div>
        <section class="dispatch-notes" aria-labelledby="archive-note-title"><h2 id="archive-note-title">About this place</h2><p>An independent archive of manga, image sets, doujinshi, artifacts, and connected paths.</p><p><a href="/about">More about AstroSphere →</a></p></section>
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .home { max-width: 96rem; padding-bottom: var(--section-space); }
  .archive-columns { align-items: start; display: grid; gap: clamp(3rem, 7vw, 8rem); grid-template-columns: minmax(18rem, .9fr) minmax(0, 1.5fr); padding-top: var(--space-3); }
  .recommendations > section { margin-top: var(--section-space); }
  .recommendations > .current-attention { border-top: 2px solid var(--color-accent); margin-top: 0; padding-top: var(--space-2); }
  .recommendations > .anime-home { border-top: 2px solid var(--color-accent-warm); padding-top: var(--space-2); }
  .anime-home .feed-heading { align-items: end; }
  .anime-home .feed-heading h2 { margin-top: .2rem; }
  .anime-home-grid { display: grid; gap: var(--space-3); padding-top: var(--space-2); }
  .current-feature { align-items: start; background: var(--color-surface); display: grid; gap: var(--space-2); grid-template-columns: 7rem minmax(0, 1fr); margin-top: var(--space-2); padding: var(--space-2); }
  .current-feature-cover { align-self: start; background: var(--color-background); display: block; }
  .current-feature-cover img { display: block; height: auto; width: 100%; }
  .current-label, .current-secondary span { color: var(--color-accent); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); margin: 0; text-transform: uppercase; }
  .current-feature h3 { font-family: var(--font-serif); font-size: clamp(1.35rem, 2.5vw, 2rem); font-weight: 500; line-height: var(--leading-tight); margin: var(--space-1) 0; }
  .current-feature h3 a, .current-secondary a { text-decoration: none; }
  .current-meta { color: var(--color-muted); font-size: var(--text-sm); line-height: var(--leading-normal); margin: 0; }
  .current-secondary { border-top: 1px solid var(--color-border); list-style: none; margin: var(--space-2) 0 0; padding: 0; }
  .current-secondary li { border-bottom: 1px solid var(--color-border); display: grid; gap: var(--space-1); padding: var(--space-2) 0; }
  .current-secondary a { font-family: var(--font-serif); font-size: var(--text-lg); }
  :global(html[data-sfw="on"]) .current-secondary [data-manga-rating="explicit"] { display: none; }
  .feed-heading { align-items: baseline; display: flex; justify-content: space-between; padding-bottom: var(--space-1); }
  .feed-heading h2 { font-family: var(--font-serif); font-size: var(--text-xl); font-weight: 500; margin: 0; }
  .feed-heading a { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); text-transform: uppercase; }
  .recommendation-list, .dispatch-list { border-top: 1px solid var(--color-border); }
  .recommendation-list :global(article:first-child) { border-top: 0; }
  .dispatch-header { border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-3); }
  .eyebrow, .dispatch-type { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); margin: 0; text-transform: uppercase; }
  .dispatch-header h2 { font-family: var(--font-serif); font-size: clamp(2.5rem, 5vw, 5rem); font-weight: 400; letter-spacing: -.05em; line-height: var(--leading-tight); margin: var(--space-1) 0 0; }
  .dispatch-group + .dispatch-group { border-top: 1px solid var(--color-border); }
  .dispatch-date { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 400; letter-spacing: var(--label-tracking); margin: 0; padding: var(--space-3) 0 var(--space-1); text-transform: uppercase; }
  .dispatch-item { border-bottom: 1px solid var(--color-border); padding: var(--space-2) 0 var(--space-3); }
  .dispatch-entry { display: block; }
  .dispatch-entry--artifact { align-items: start; display: grid; gap: var(--space-3); grid-template-columns: 7rem minmax(0, 1fr); }
  .dispatch-thumb { align-self: start; background: var(--color-surface); display: block; }
  .dispatch-thumb img { aspect-ratio: 4 / 3; display: block; height: auto; object-fit: cover; width: 100%; }
  .dispatch-copy { max-width: 48rem; }
  .dispatch-copy h4 { font-family: var(--font-serif); font-size: var(--text-xl); font-weight: 500; margin: var(--space-1) 0; }
  .dispatch-copy h4 a { text-decoration: none; }
  .dispatch-copy p:not(.dispatch-type) { line-height: var(--leading-reading); margin: 0; }
  .dispatch-notes { border-top: 1px solid var(--color-border); margin-top: var(--section-space); padding-top: var(--space-3); }
  .dispatch-notes h2 { font-family: var(--font-serif); font-size: var(--text-xl); font-weight: 500; margin: 0 0 var(--space-1); }
  .dispatch-notes p { line-height: var(--leading-reading); margin: var(--space-1) 0 0; max-width: 44rem; }
  :global(html[data-sfw="on"]) .recommendation-list [data-manga-rating="explicit"], :global(html[data-sfw="on"]) .recommendation-list [data-image-set-rating="explicit"] { display: none; }
  @media (max-width: 52rem) { .archive-columns { grid-template-columns: minmax(0, 1fr); } .recommendations { display: grid; gap: var(--space-4); grid-template-columns: repeat(2, minmax(0, 1fr)); } .recommendations > section { margin-top: 0; } }
  @media (max-width: 36rem) { .recommendations { display: block; } .recommendations > section { margin-top: var(--section-space); } .current-attention { margin-top: 0 !important; } .current-feature { grid-template-columns: 5rem minmax(0, 1fr); } }
</style>
