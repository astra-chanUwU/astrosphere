---
import ArtifactCard from "../components/ArtifactCard.astro";
import ImageSetCard from "../components/ImageSetCard.astro";
import MangaSeriesCard from "../components/MangaSeriesCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  assertPublishingGuardrails,
  getPublishedArtifacts,
  getPublishedImageSets,
  getPublishedMangaChapters,
  getPublishedMangaSeries,
  getPublishedTrails,
} from "../lib/content";
import { getShelfSelections } from "../lib/shelf";
import { createMangaCoverPreviewSrc, getMangaPublicPath } from "../lib/manga-reader";

if (import.meta.env.PROD) await assertPublishingGuardrails();

const [artifacts, imageSets, mangaSeries, chapters, trails, shelf] = await Promise.all([
  getPublishedArtifacts(),
  getPublishedImageSets(),
  getPublishedMangaSeries(),
  getPublishedMangaChapters(),
  getPublishedTrails(),
  getShelfSelections(),
]);

const chapterCountBySeriesSlug = new Map<string, number>();
const seriesBySlug = new Map(mangaSeries.map((series) => [series.data.slug, series]));
for (const chapter of chapters) {
  chapterCountBySeriesSlug.set(chapter.data.series, (chapterCountBySeriesSlug.get(chapter.data.series) ?? 0) + 1);
}

type Dispatch =
  | { kind: "artifact"; date: Date; item: (typeof artifacts)[number] }
  | { kind: "image-set"; date: Date; item: (typeof imageSets)[number] }
  | { kind: "chapter"; date: Date; item: (typeof chapters)[number]; seriesTitle: string }
  | { kind: "trail"; date: Date; item: (typeof trails)[number] };

const dispatches: Dispatch[] = [
  ...artifacts.map((item) => ({ kind: "artifact" as const, date: item.data.updatedAt ?? item.data.publishedAt, item })),
  ...imageSets.map((item) => ({ kind: "image-set" as const, date: item.data.updatedAt ?? item.data.publishedAt, item })),
  ...chapters.flatMap((item) => item.data.publishedAt ? [{ kind: "chapter" as const, date: item.data.publishedAt, item, seriesTitle: seriesBySlug.get(item.data.series)?.data.title ?? item.data.series }] : []),
  ...trails.flatMap((item) => item.data.updatedAt ? [{ kind: "trail" as const, date: item.data.updatedAt, item }] : []),
].sort((left, right) => right.date.getTime() - left.date.getTime()).slice(0, 12);

const newestImageSets = imageSets.slice(0, 5);
const recommendedManga = shelf.manga.slice(0, 5);
const recommendedDoujinshi = shelf.doujinshi.slice(0, 5);
const currentManga = recommendedManga[0];
const currentImageSet = newestImageSets[0];
const currentDoujinshi = recommendedDoujinshi[0];
---

<BaseLayout title="AstroSphere" description="An independent archive of manga, image sets, doujinshi, artifacts, and connected trails.">
  <div class="page-shell home">
    <div class="archive-columns">
      <aside class="recommendations">
        <section class="current-attention" aria-labelledby="current-attention-title"><div class="feed-heading"><h2 id="current-attention-title">Now</h2><a href="/now">All →</a></div>{currentManga && <article class="current-feature" data-manga-rating={currentManga.data.rating}><a class="current-feature-cover" href={getMangaPublicPath(currentManga.data.format, currentManga.data.slug)}>{currentManga.data.cover && <img src={createMangaCoverPreviewSrc(currentManga.data.format, currentManga.data.slug, currentManga.data.cover.src)} alt={currentManga.data.cover.alt ?? `${currentManga.data.title} cover`} loading="eager" decoding="async" />}</a><div><p class="current-label">Read next</p><h3><a href={getMangaPublicPath(currentManga.data.format, currentManga.data.slug)}>{currentManga.data.title}</a></h3><p class="current-meta">{currentManga.data.originalTitle}</p></div></article>}{(currentImageSet || currentDoujinshi) && <ul class="current-secondary">{currentImageSet && <li><span>Recent set</span><a href={`/image-sets/${currentImageSet.data.slug}`}>{currentImageSet.data.title}</a></li>}{currentDoujinshi && <li data-manga-rating={currentDoujinshi.data.rating}><span>Adult shelf</span><a href={getMangaPublicPath(currentDoujinshi.data.format, currentDoujinshi.data.slug)}>{currentDoujinshi.data.title}</a></li>}</ul>}</section>
        <section aria-labelledby="manga-recommendations-title"><div class="feed-heading"><h2 id="manga-recommendations-title">Read next</h2><a href="/manga">All →</a></div><div class="recommendation-list">{recommendedManga.map((series) => <MangaSeriesCard {series} chapterCount={chapterCountBySeriesSlug.get(series.data.slug) ?? 0} />)}</div></section>
        <section aria-labelledby="image-set-recommendations-title"><div class="feed-heading"><h2 id="image-set-recommendations-title">Recent sets</h2><a href="/image-sets">All →</a></div><div class="recommendation-list">{newestImageSets.map((imageSet) => <ImageSetCard {imageSet} />)}</div></section>
        <section aria-labelledby="doujinshi-recommendations-title"><div class="feed-heading"><h2 id="doujinshi-recommendations-title">Doujinshi</h2><a href="/doujinshi">All →</a></div><div class="recommendation-list">{recommendedDoujinshi.map((series) => <MangaSeriesCard {series} chapterCount={chapterCountBySeriesSlug.get(series.data.slug) ?? 0} />)}</div></section>
      </aside>

      <main class="dispatches" aria-labelledby="dispatches-title">
        <header class="dispatch-header"><p class="eyebrow">Archive activity</p><h2 id="dispatches-title">Dispatches</h2><p>Latest additions and changes in the archive.</p></header>
        <div class="dispatch-list">
          {dispatches.map((dispatch) => <article class="dispatch-item">
            <time datetime={dispatch.date.toISOString()}>{dispatch.date.toLocaleDateString("en", { year: "numeric", month: "short", day: "numeric" })}</time>
            {dispatch.kind === "artifact" && <div class="dispatch-copy"><p class="dispatch-type">New artifact</p><ArtifactCard artifact={dispatch.item} visual /></div>}
            {dispatch.kind === "image-set" && <div class="dispatch-copy"><p class="dispatch-type">New image set</p><h3><a href={`/image-sets/${dispatch.item.data.slug}`}>{dispatch.item.data.title}</a></h3><p>{dispatch.item.data.summary}</p></div>}
            {dispatch.kind === "chapter" && <div class="dispatch-copy"><p class="dispatch-type">New chapter</p><h3><a href={`/manga/${dispatch.item.data.series}/${dispatch.item.data.slug}`}>{dispatch.seriesTitle} — {dispatch.item.data.title}</a></h3><p>Chapter {dispatch.item.data.number} added to the reader.</p></div>}
            {dispatch.kind === "trail" && <div class="dispatch-copy"><p class="dispatch-type">Updated trail</p><h3><a href={`/trails/${dispatch.item.data.slug}`}>{dispatch.item.data.title}</a></h3><p>{dispatch.item.data.summary}</p></div>}
          </article>)}
        </div>
        <section class="dispatch-notes" aria-labelledby="archive-note-title"><h2 id="archive-note-title">About this place</h2><p>An independent archive of manga, image sets, doujinshi, artifacts, and connected trails.</p><p><a href="/about">More about AstroSphere →</a></p></section>
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .home { max-width: 96rem; padding-bottom: var(--section-space); }
  .archive-columns { align-items: start; display: grid; gap: clamp(3rem, 7vw, 8rem); grid-template-columns: minmax(18rem, .9fr) minmax(0, 1.5fr); padding-top: var(--space-3); }
  .dispatch-header > p:last-child { color: var(--color-muted); font-family: var(--font-serif); font-size: var(--text-lg); line-height: var(--leading-reading); margin: var(--space-1) 0 0; }
  .recommendations > section { margin-top: var(--section-space); }
  .recommendations > .current-attention { border-top: 2px solid var(--color-accent); margin-top: 0; padding-top: var(--space-2); }
  .current-feature { align-items: start; background: var(--color-surface); display: grid; gap: var(--space-2); grid-template-columns: 7rem minmax(0, 1fr); margin-top: var(--space-2); padding: var(--space-2); }
  .current-feature-cover { align-self: start; background: var(--color-background); display: block; }
  .current-feature-cover img { display: block; height: auto; width: 100%; }
  .current-label, .current-secondary span { color: var(--color-accent); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); margin: 0; text-transform: uppercase; }
  .current-feature h3 { font-family: var(--font-serif); font-size: clamp(1.35rem, 2.5vw, 2rem); font-weight: 500; line-height: var(--leading-tight); margin: var(--space-1) 0; }
  .current-feature h3 a, .current-secondary a { text-decoration: none; }
  .current-meta { color: var(--color-muted); font-size: var(--text-sm); line-height: var(--leading-normal); margin: 0; }
  .current-secondary { border-top: 1px solid var(--color-border); list-style: none; margin: var(--space-2) 0 0; padding: 0; }
  .current-secondary li { border-bottom: 1px solid var(--color-border); display: grid; gap: var(--space-1); padding: var(--space-2) 0; }
  .current-secondary a { font-family: var(--font-serif); font-size: var(--text-lg); }
  :global(html[data-sfw="on"]) .current-secondary [data-manga-rating="explicit"] { display: none; }
  .feed-heading { align-items: baseline; display: flex; justify-content: space-between; padding-bottom: var(--space-1); }
  .feed-heading h2 { font-family: var(--font-serif); font-size: var(--text-xl); font-weight: 500; margin: 0; }
  .feed-heading a { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); text-transform: uppercase; }
  .recommendation-list, .dispatch-list { border-top: 1px solid var(--color-border); }
  .recommendation-list :global(article:first-child) { border-top: 0; }
  .dispatch-header { border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-3); }
  .eyebrow, .dispatch-type { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); margin: 0; text-transform: uppercase; }
  .dispatch-header h2 { font-family: var(--font-serif); font-size: clamp(2.5rem, 5vw, 5rem); font-weight: 400; letter-spacing: -.05em; line-height: var(--leading-tight); margin: var(--space-1) 0 0; }
  .dispatch-item { border-bottom: 1px solid var(--color-border); padding: var(--space-3) 0; }
  .dispatch-item > time { color: var(--color-muted); display: block; font-size: var(--text-sm); margin-bottom: var(--space-2); }
  .dispatch-item :global(.artifact-card--visual) { border-top: 0; padding: 0; }
  .dispatch-copy :global(.artifact-card--visual) { margin-top: var(--space-1); }
  .dispatch-copy { max-width: 48rem; }
  .dispatch-copy h3 { font-family: var(--font-serif); font-size: var(--text-xl); font-weight: 500; margin: var(--space-1) 0; }
  .dispatch-copy h3 a { text-decoration: none; }
  .dispatch-copy p:not(.dispatch-type) { line-height: var(--leading-reading); margin: 0; }
  .dispatch-notes { border-top: 1px solid var(--color-border); margin-top: var(--section-space); padding-top: var(--space-3); }
  .dispatch-notes h2 { font-family: var(--font-serif); font-size: var(--text-xl); font-weight: 500; margin: 0 0 var(--space-1); }
  .dispatch-notes p { line-height: var(--leading-reading); margin: var(--space-1) 0 0; max-width: 44rem; }
  :global(html[data-sfw="on"]) .recommendation-list [data-manga-rating="explicit"], :global(html[data-sfw="on"]) .recommendation-list [data-image-set-rating="explicit"] { display: none; }
  @media (max-width: 52rem) { .archive-columns { grid-template-columns: minmax(0, 1fr); } .recommendations { display: grid; gap: var(--space-4); grid-template-columns: repeat(2, minmax(0, 1fr)); } .recommendations > section { margin-top: 0; } }
  @media (max-width: 36rem) { .recommendations { display: block; } .recommendations > section { margin-top: var(--section-space); } .current-attention { margin-top: 0 !important; } .current-feature { grid-template-columns: 5rem minmax(0, 1fr); } }
</style>
