---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ArchivePageHeader from "../../components/ArchivePageHeader.astro";
import type { SidebarModel } from "../../config/navigation";
import { getPublishedTrails, getTrailItemTargets } from "../../lib/content";

export async function getStaticPaths() {
  const trails = await getPublishedTrails();
  return trails.map((trail) => ({ params: { slug: trail.data.slug }, props: { trail } }));
}

interface Props { trail: CollectionEntry<"trails">; }
const { trail } = Astro.props;
const [{ Content }, targets] = await Promise.all([render(trail), getTrailItemTargets(trail)]);
const sidebar: SidebarModel = {
  heading: "Trail contents",
  groups: [
    { items: [{ href: "/guides", label: "All guides" }] },
    { label: "In this guide", items: targets.map((target, index) => ({ href: target.href, label: `${index + 1}. ${target.entry.data.title}`, external: target.external })) },
  ],
};
---
<BaseLayout title={trail.data.title} description={trail.data.summary} sidebar={sidebar} pagefindFilters={[{ name: "kind", value: "trail" }, ...trail.data.spheres.map((value) => ({ name: "sphere", value }))]}><div class="page-shell trail-dossier"><Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Guides", href: "/guides" }, { label: trail.data.title }]}/><ArchivePageHeader eyebrow="Connected route" title={trail.data.title} variant="trails" summary={trail.data.summary} /><div class="trail-layout"><main><article class="prose"><Content/></article><section class="trail-section" aria-labelledby="trail-items-heading"><div class="section-heading"><h2 id="trail-items-heading">Guide stops</h2><span>{targets.length}</span></div><ol class="trail-stops">{targets.map((target, index) => <li><span class="stop-number">{String(index + 1).padStart(2, "0")}</span><div class="stop-content"><p class="stop-kind">{target.external ? "External signal" : "Archive entry"}</p><h3>{target.external ? <a href={target.href} target="_blank" rel="noopener noreferrer">{target.entry.data.title} ↗</a> : <a href={target.href}>{target.entry.data.title}</a>}</h3>{target.item.note && <p class="stop-note">{target.item.note}</p>}</div></li>)}</ol></section></main><aside class="trail-overview"><p class="rail-label">Route details</p><dl>{trail.data.estimatedTime && <div><dt>Time</dt><dd>{trail.data.estimatedTime}</dd></div>}<div><dt>Stops</dt><dd>{targets.length}</dd></div><div><dt>Featured</dt><dd>{trail.data.featured ? "Yes" : "No"}</dd></div></dl><nav aria-label="Guide sections"><a href="#trail-items-heading">Guide stops</a><a href="/guides">All guides →</a></nav></aside></div></div></BaseLayout>
<style>.trail-dossier{max-width:96rem}.trail-layout{align-items:start;display:grid;gap:clamp(2rem,4vw,4rem);grid-template-columns:minmax(0,1.5fr) minmax(13rem,.65fr)}.trail-section{margin-top:var(--space-5)}.section-heading{align-items:baseline;border-bottom:1px solid var(--color-border);display:flex;justify-content:space-between;padding-bottom:var(--space-1)}.section-heading h2{font-family:var(--font-serif);font-size:var(--text-xl);font-weight:500;line-height:var(--leading-tight);margin:0}.section-heading>span{color:var(--color-muted);font-family:var(--font-mono);font-size:var(--text-xs);letter-spacing:var(--label-tracking)}.trail-stops{list-style:none;margin:0;padding:0}.trail-stops li{border-bottom:1px solid var(--color-border);display:grid;gap:var(--space-3);grid-template-columns:2.5rem minmax(0,1fr);padding:var(--space-3) 0}.stop-number{color:var(--color-accent-warm);font-family:var(--font-mono);font-size:var(--text-sm);padding-top:.2rem}.stop-kind,.rail-label,dt,.trail-overview nav a{color:var(--color-muted);font-family:var(--font-mono);font-size:var(--text-xs);letter-spacing:var(--label-tracking);margin:0;text-transform:uppercase}.stop-content h3{font-family:var(--font-serif);font-size:clamp(1.35rem,2.5vw,2rem);font-weight:500;line-height:var(--leading-tight);margin:var(--space-1) 0}.stop-content h3 a{text-decoration:none}.stop-note{color:var(--color-muted);line-height:var(--leading-reading);margin:0;max-width:40rem}.trail-overview{align-self:start;border-left:2px solid var(--color-accent-warm);padding-left:var(--space-3);position:sticky;top:var(--space-3)}.rail-label{color:var(--color-accent-warm);margin-bottom:var(--space-2)}dl{border-top:1px solid var(--color-border);margin:0}dl div{align-items:baseline;border-bottom:1px solid var(--color-border);display:flex;justify-content:space-between;padding:var(--space-1) 0}dd{margin:0}.trail-overview nav{display:grid;gap:var(--space-1);margin-top:var(--space-4)}.trail-overview nav a{text-decoration:none}@media(max-width:52rem){.trail-layout{grid-template-columns:minmax(0,1fr)}.trail-overview{border-left:0;border-top:2px solid var(--color-accent-warm);padding:var(--space-3) 0 0;position:static}}
</style>
