---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArtifactMeta from "../../components/ArtifactMeta.astro";
import ArchivePageHeader from "../../components/ArchivePageHeader.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MediaFrame from "../../components/MediaFrame.astro";
import MediaGallery from "../../components/MediaGallery.astro";
import RelatedArtifacts from "../../components/RelatedArtifacts.astro";
import SignalCard from "../../components/SignalCard.astro";
import TrailProgress from "../../components/TrailProgress.astro";
import type { SidebarModel } from "../../config/navigation";
import { getPublishedArtifacts, getRelatedArtifacts, getSignalsForArtifact, getTrailProgressForArtifact, getTrailsForArtifact } from "../../lib/content";
import { createManagedImageThumbnailSrc } from "../../lib/managed-image-thumbnails";

export async function getStaticPaths() {
  const artifacts = await getPublishedArtifacts();
  return artifacts.map((artifact) => ({ params: { slug: artifact.data.slug }, props: { artifact } }));
}

interface Props { artifact: CollectionEntry<"artifacts">; }
const { artifact } = Astro.props;
const [{ Content }, related, signals, trails, trailProgress] = await Promise.all([render(artifact), getRelatedArtifacts(artifact), getSignalsForArtifact(artifact), getTrailsForArtifact(artifact.data.slug), getTrailProgressForArtifact(artifact.data.slug)]);
const mediaPreviewSources = artifact.data.media.map((item) =>
  item.kind === "image" ? createManagedImageThumbnailSrc(item.src) : undefined,
);
const sidebar: SidebarModel = {
  heading: "Article details",
  groups: [
    { items: [{ href: "/articles", label: "All articles" }] },
    { label: "Topics", items: artifact.data.spheres.map((slug) => ({ href: `/topics/${slug}`, label: slug })) },
    { label: "Tags", items: artifact.data.tags.map((tag) => ({ href: `/tags/${tag}`, label: `#${tag}` })) },
    ...(related.length ? [{ label: "Related", items: related.map((entry) => ({ href: `/articles/${entry.data.slug}`, label: entry.data.title })) }] : []),
  ],
};
---
<BaseLayout title={artifact.data.title} description={artifact.data.summary} image={artifact.data.hero?.src} type="article" canonicalUrl={artifact.data.canonicalUrl} sidebar={sidebar} readerDock pagefindFilters={[{ name: "kind", value: artifact.data.type }, ...artifact.data.spheres.map((value) => ({ name: "sphere", value })), ...artifact.data.tags.map((value) => ({ name: "tag", value }))]}>
  <div class="page-shell" data-layout={artifact.data.layout} data-slug={artifact.data.slug}>
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Articles", href: "/articles" }, { label: artifact.data.title }]}/>
    <ArchivePageHeader eyebrow={artifact.data.type.replace("-", " ")} title={artifact.data.title} variant="artifacts" summary={artifact.data.summary} pixelTitle={false} />
    <div class="artifact-layout"><main>
      {artifact.data.hero && <div class="hero-frame"><MediaFrame media={artifact.data.hero} priority/></div>}
      <article id="article" class="prose"><Content/></article>
      {trailProgress.map((progress) => <TrailProgress {progress}/>) }
      {artifact.data.media.length > 0 && <div class="media-wide"><MediaGallery media={artifact.data.media} imagePreviewSources={mediaPreviewSources} linkImagesToFullSize/></div>}
      {artifact.data.transcript && <section id="transcript" class="transcript"><h2>Transcript</h2><p>{artifact.data.transcript}</p></section>}
      {(artifact.data.externalUrl || artifact.data.sourceUrl) && <section class="links"><h2>Elsewhere</h2>{artifact.data.externalUrl && <a href={artifact.data.externalUrl}>Visit external source</a>}{artifact.data.sourceUrl && <a href={artifact.data.sourceUrl}>View source material</a>}</section>}
      {trails.length > 0 && <section class="links"><h2>Continue with a path</h2>{trails.map((trail) => <a href={`/paths/${trail.data.slug}`}>{trail.data.title}</a>)}</section>}
      {signals.length > 0 && <section class="signals"><h2>Links to follow</h2>{signals.map((signal) => <SignalCard {signal}/>)}</section>}
      <RelatedArtifacts artifacts={related}/>
    </main><aside class="artifact-rail"><p class="rail-label">Article details</p><ArtifactMeta {artifact}/><nav aria-label="Artifact sections"><a href="#article">Article</a>{artifact.data.media.length > 0 && <a href="#media-gallery-heading">Media</a>}{artifact.data.transcript && <a href="#transcript">Transcript</a>}</nav></aside></div>
  </div>
</BaseLayout>

<style>
  .artifact-layout { align-items: start; display: grid; gap: clamp(2rem, 4vw, 4rem); grid-template-columns: minmax(0, 1.5fr) minmax(13rem, .65fr); }
  .artifact-layout main { min-width: 0; }
  .artifact-rail { align-self: start; border-left: 2px solid var(--color-accent); padding-left: var(--space-3); position: sticky; top: var(--space-3); }
  .rail-label { color: var(--color-accent); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); margin: 0 0 var(--space-2); text-transform: uppercase; }
  .artifact-rail :global(dl) { margin: 0; }
  .artifact-rail nav { display: grid; gap: var(--space-1); margin-top: var(--space-4); }
  .artifact-rail nav a { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); text-transform: uppercase; }
  .hero-frame { margin-bottom: var(--space-4); }
  .hero-frame { display: grid; justify-items: center; }
  .hero-frame :global(figure) { margin: 0; max-width: 100%; width: fit-content; }
  .hero-frame :global(.media-image) { height: auto; margin-inline: auto; max-height: clamp(16rem, 42svh, 30rem); max-width: 100%; object-fit: contain; width: auto; }
  .media-wide { margin-inline: auto; max-width: calc(var(--content-width) - var(--gutter) * 2); }
  .links h2, .transcript h2, .signals h2 { font-family: var(--font-serif); font-size: var(--text-xl); font-weight: 500; }
  .links, .transcript, .signals { margin-top: var(--space-4); max-width: var(--reading-width); }
  .links { display: flex; flex-direction: column; gap: var(--space-1); }
  .transcript p { line-height: var(--leading-reading); white-space: pre-line; }
  #article { scroll-margin-top: var(--space-3); }
  #transcript { scroll-margin-top: var(--space-3); }
  @media (max-width: 52rem) { .artifact-layout { grid-template-columns: minmax(0, 1fr); } .artifact-rail { border-left: 0; border-top: 2px solid var(--color-accent); padding: var(--space-3) 0 0; position: static; } }

