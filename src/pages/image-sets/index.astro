---
import ShelfArchive from "../../components/ShelfArchive.astro";
import ArchivePageHeader from "../../components/ArchivePageHeader.astro";
import ArchiveRail from "../../components/ArchiveRail.astro";
import { SHELF_PAGE_SIZE } from "../../config/shelf";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getShelfArchive } from "../../lib/shelf";

const entries = await getShelfArchive("image-sets");
const currentPage = 1;
const lastPage = Math.ceil(entries.length / SHELF_PAGE_SIZE);
const chapterCountBySeriesSlug = new Map<string, number>();
---

<BaseLayout title="Image sets" description="The image-set archive.">
  <div class="page-shell">
    <ArchivePageHeader eyebrow="Visual collections" title="Image-set" variant="image-sets" summary="Published image sets in the archive." />
    <div class="archive-layout"><ShelfArchive category="image-sets" entries={entries.slice(0, SHELF_PAGE_SIZE)} {currentPage} {lastPage} {chapterCountBySeriesSlug} basePath="/image-sets" /><ArchiveRail active="image-sets" /></div>
  </div>
</BaseLayout>

<style>
  .archive-layout { align-items: start; display: grid; gap: clamp(2rem, 4cqi, 4rem); grid-template-columns: minmax(0, 2fr) minmax(13rem, .8fr); }
  @container content (max-width: 48rem) { .archive-layout { grid-template-columns: minmax(0, 1fr); } }
</style>
