---
import type { GetStaticPaths } from "astro";
import ShelfArchive from "../../../components/ShelfArchive.astro";
import { SHELF_PAGE_SIZE } from "../../../config/shelf";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getShelfArchive } from "../../../lib/shelf";

export const getStaticPaths = (async ({ paginate }) => paginate(await getShelfArchive("image-sets"), { pageSize: SHELF_PAGE_SIZE }).filter((path) => Number(path.params.page) > 1)) satisfies GetStaticPaths;
const { page } = Astro.props;
const chapterCountBySeriesSlug = new Map<string, number>();
---
<BaseLayout title={`Image sets — page ${page.currentPage}`} description="The image-set archive."><div class="page-shell"><header><p class="eyebrow">Visual collections</p><h1>Image sets</h1><p>Published image sets in the archive.</p></header><ShelfArchive category="image-sets" entries={page.data} currentPage={page.currentPage} lastPage={page.lastPage} {chapterCountBySeriesSlug} basePath="/image-sets" /></div></BaseLayout>
<style>header{max-width:var(--reading-width);padding:var(--section-space) 0 var(--space-4)}.eyebrow{color:var(--color-muted);font-family:var(--font-mono);font-size:var(--text-xs);letter-spacing:var(--label-tracking);text-transform:uppercase}h1{font-family:var(--font-serif);font-size:var(--text-2xl);font-weight:500;margin:var(--space-1) 0}header p:last-child{font-family:var(--font-serif);font-size:var(--text-lg);line-height:var(--leading-reading)}</style>
