---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkContactCta from "../components/WorkContactCta.astro";
import WorkProcessStep from "../components/WorkProcessStep.astro";
import WorkServiceCard from "../components/WorkServiceCard.astro";
import { getPublishedPages } from "../lib/content";

const work = (await getPublishedPages()).find((page) => page.data.pageType === "work");
if (!work) throw new Error("A published page with pageType: work is required for /work.");
const { Content } = await render(work);
const services = [
  { title: "Personal websites", description: "A considered online home for a person, practice, or body of work—not a generic profile page.", examples: ["portfolios", "personal archives", "online homes", "creator websites", "documentation sites"] },
  { title: "Blogs and publishing systems", description: "Editorial foundations that make writing, organizing, and keeping content portable feel straightforward.", examples: ["Astro blogs", "editorial sites", "Markdown-based publishing", "content collections", "migration from heavier CMS systems"] },
  { title: "Small e-commerce websites", description: "Focused product and storefront experiences, with checkout integrations discussed only when they fit the project.", examples: ["product catalogs", "small shops", "product landing pages", "storefront interfaces", "simple checkout integrations"] },
  { title: "Custom solo-developer projects", description: "Small, purposeful web projects that need a custom shape without the overhead of a large platform.", examples: ["landing pages", "interactive experiments", "documentation portals", "small tools", "microsites", "lightweight web applications", "media-rich websites"] },
];
---
<BaseLayout title="Work with Astro" description="Independent web development for thoughtful personal sites, publishing systems, small shops, and focused digital projects."><div class="page-shell"><header class="hero"><p class="name">Astro Chan</p><h1>I’m available for focused freelance work.</h1><p class="statement">I build small, durable websites for people, projects, and independent businesses that want something clearer, faster, and more personal than a template.</p></header><WorkContactCta/><article class="prose"><Content/></article><section aria-labelledby="services-heading"><h2 id="services-heading">What I can help build</h2><div class="services">{services.map((service) => <WorkServiceCard {...service}/>)}</div></section><section class="tools" aria-labelledby="tools-heading"><h2 id="tools-heading">How I work</h2><p>I use Astro, TypeScript, Markdown and MDX, modern CSS, accessible semantic HTML, static-first architecture, lightweight JavaScript, Bun, and APIs or third-party services when they genuinely help.</p><p>The point is not a stack for its own sake. It is fast pages, maintainable code, portable content, excellent reading experiences, low hosting complexity, and a website that remains resilient after launch.</p></section><section class="fit-grid" aria-label="Project fit guidance"><div><h2>Good fit</h2><p>We will probably work well together if you want a focused website rather than a huge platform; direct communication with the developer; a strong content or editorial foundation; a fast, accessible site; custom personality; a maintainable codebase; and a clear, realistic scope.</p></div><div><h2>Maybe not the right fit</h2><p>I may not be the best match for large enterprise systems, massive social networks, projects needing a large development team, projects without a decision-maker, or urgent work that requires skipping planning and quality checks. No hard feelings—fit matters.</p></div></section><section aria-labelledby="process-heading"><h2 id="process-heading">A small, clear process</h2><div class="process"><WorkProcessStep number={1} title="Say hello" description="You describe the project, idea, or problem."/><WorkProcessStep number={2} title="Clarify the shape" description="We define scope, content, features, and technical direction."/><WorkProcessStep number={3} title="Build the first useful version" description="I implement focused stages with visible progress."/><WorkProcessStep number={4} title="Refine and hand off" description="The final site is tested, documented, and prepared for deployment or future maintenance."/></div></section><section class="crypto" aria-labelledby="crypto-heading"><h2 id="crypto-heading">Payment notes</h2><p>Crypto payments can be discussed for suitable projects. Payment terms, currency, network, conversion, and transaction responsibilities should be agreed before work begins.</p></section><div id="start-a-conversation"><WorkContactCta/></div></div></BaseLayout>
<style>.hero{max-width:var(--reading-width);padding-top:var(--section-space)}.name{color:var(--color-muted);font-size:var(--text-sm);margin:0}.hero h1,h2{font-family:var(--font-serif);font-weight:500;line-height:var(--leading-tight)}.hero h1{font-size:var(--text-2xl);margin:var(--space-1) 0}.statement{font-family:var(--font-serif);font-size:var(--text-lg);line-height:var(--leading-reading)}section{margin-top:var(--section-space)}section>h2{font-size:var(--text-xl)}.services{display:grid;gap:var(--space-2);grid-template-columns:repeat(2,minmax(0,1fr))}.tools{max-width:var(--reading-width)}.tools p,.fit-grid p,.crypto p{line-height:var(--leading-reading)}.fit-grid{display:grid;gap:var(--space-4);grid-template-columns:repeat(2,minmax(0,1fr))}.fit-grid>div{border-top:var(--border-width) solid var(--color-border)}.process{max-width:var(--reading-width)}.crypto{border-top:var(--border-width) solid var(--color-border);max-width:var(--reading-width)}@container content (max-width:42rem){.services,.fit-grid{grid-template-columns:1fr}}</style>
