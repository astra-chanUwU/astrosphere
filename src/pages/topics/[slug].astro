---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ArchivePageHeader from "../../components/ArchivePageHeader.astro";
import SphereCard from "../../components/SphereCard.astro";
import ArtifactCard from "../../components/ArtifactCard.astro";
import SignalCard from "../../components/SignalCard.astro";
import type { SidebarModel } from "../../config/navigation";
import { getArtifactsForSphere, getPublishedArtifacts, getPublishedSpheres, getPublishedTrails, getSignalsForSphere } from "../../lib/content";
export async function getStaticPaths() { const spheres = await getPublishedSpheres(); return spheres.map((sphere) => ({ params: { slug: sphere.data.slug }, props: { sphere } })); }
interface Props { sphere: CollectionEntry<"spheres">; }
const { sphere } = Astro.props;
const [rendered, allSpheres, artifacts, allArtifacts, trails, signals] = await Promise.all([render(sphere), getPublishedSpheres(), getArtifactsForSphere(sphere.data.slug), getPublishedArtifacts(), getPublishedTrails(), getSignalsForSphere(sphere.data.slug)]);
const { Content } = rendered;
const children = allSpheres.filter((candidate) => candidate.data.parent === sphere.data.slug);
const relatedTrails = trails.filter((trail) => trail.data.spheres.includes(sphere.data.slug) || trail.data.items.some((item) => item.kind === "sphere" && item.slug === sphere.data.slug));
const sidebar: SidebarModel = {
  heading: sphere.data.title,
  groups: [
    { items: [{ href: "/topics", label: "All topics" }] },
    ...(children.length ? [{ label: "Within this topic", items: children.map((child) => ({ href: `/topics/${child.data.slug}`, label: child.data.title })) }] : []),
    { label: "In this topic", items: [{ href: "#artifacts", label: `Articles (${artifacts.length})` }, { href: "#signals", label: `Links (${signals.length})` }, { href: "#trails", label: `Ways through (${relatedTrails.length})` }] },
  ],
};
---
<BaseLayout title={sphere.data.title} description={sphere.data.summary} sidebar={sidebar} pagefindFilters={[{ name: "kind", value: "sphere" }, { name: "sphere", value: sphere.data.slug }]}><div class="page-shell territory-dossier" data-palette={sphere.data.palette}><Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Topics", href: "/topics" }, { label: sphere.data.title }]}/><ArchivePageHeader eyebrow={`${sphere.data.palette} topic`} title={sphere.data.title} variant="spheres" summary={sphere.data.summary} /><div class="territory-grid"><main><article class="prose"><Content/></article>{children.length > 0 && <section class="territory-section" aria-labelledby="children-heading"><div class="section-heading"><h2 id="children-heading">Within this topic</h2><span>{children.length}</span></div><div class="sphere-children">{children.map((child) => <SphereCard sphere={child} childCount={allSpheres.filter((candidate) => candidate.data.parent === child.data.slug).length} artifactCount={allArtifacts.filter((artifact) => artifact.data.spheres.includes(child.data.slug)).length}/>)}</div></section>}<section class="territory-section" id="artifacts" aria-labelledby="artifacts-heading"><div class="section-heading"><h2 id="artifacts-heading">Articles</h2><span>{artifacts.length}</span></div>{artifacts.length ? artifacts.map((artifact) => <ArtifactCard {artifact}/>) : <p class="empty">This sphere is still gathering its first artifacts.</p>}</section>{signals.length > 0 && <section class="territory-section" id="signals" aria-labelledby="signals-heading"><div class="section-heading"><h2 id="signals-heading">Links</h2><span>{signals.length}</span></div>{signals.map((signal) => <SignalCard {signal}/>)}</section>}{relatedTrails.length > 0 && <section class="territory-section" id="trails" aria-labelledby="trails-heading"><div class="section-heading"><h2 id="trails-heading">Ways through</h2><span>{relatedTrails.length}</span></div><ul class="trail-list">{relatedTrails.map((trail) => <li><a href={`/guides/${trail.data.slug}`}><strong>{trail.data.title}</strong></a><span>{trail.data.items.length} stops</span></li>)}</ul></section>}</main><aside class="territory-rail"><p class="rail-label">Topic details</p><dl><div><dt>Palette</dt><dd>{sphere.data.palette}</dd></div><div><dt>Articles</dt><dd>{artifacts.length}</dd></div><div><dt>Links</dt><dd>{signals.length}</dd></div><div><dt>Guides</dt><dd>{relatedTrails.length}</dd></div></dl><nav aria-label="Sphere sections"><a href="#artifacts">Articles</a>{signals.length > 0 && <a href="#signals">Links</a>}{relatedTrails.length > 0 && <a href="#trails">Ways through</a>}</nav></aside></div></div></BaseLayout>
<style>[data-palette="paper"]{--local-accent:var(--color-paper)}[data-palette="moss"]{--local-accent:var(--color-moss)}[data-palette="ember"]{--local-accent:var(--color-ember)}[data-palette="ocean"]{--local-accent:var(--color-ocean)}[data-palette="dusk"]{--local-accent:var(--color-dusk)}[data-palette="mineral"]{--local-accent:var(--color-mineral)}.territory-dossier{max-width:96rem}.territory-grid{align-items:start;display:grid;gap:clamp(2rem,4vw,4rem);grid-template-columns:minmax(0,1.5fr) minmax(13rem,.65fr)}.territory-section{margin-top:var(--space-5)}.section-heading{align-items:baseline;border-bottom:1px solid var(--color-border);display:flex;justify-content:space-between;padding-bottom:var(--space-1)}.section-heading h2{font-family:var(--font-serif);font-size:var(--text-xl);font-weight:500;line-height:var(--leading-tight);margin:0}.section-heading span{color:var(--color-muted);font-family:var(--font-mono);font-size:var(--text-xs);letter-spacing:var(--label-tracking)}.sphere-children{border-top:1px solid var(--color-border)}.territory-rail{align-self:start;border-left:2px solid var(--local-accent,var(--color-accent));padding-left:var(--space-3);position:sticky;top:var(--space-3)}.rail-label,dt,.territory-rail nav a{font-family:var(--font-mono);font-size:var(--text-xs);letter-spacing:var(--label-tracking);text-transform:uppercase}.rail-label{color:var(--local-accent,var(--color-accent));margin:0 0 var(--space-2)}dl{border-top:1px solid var(--color-border);margin:0}dl div{align-items:baseline;border-bottom:1px solid var(--color-border);display:flex;justify-content:space-between;padding:var(--space-1) 0}dt{color:var(--color-muted)}dd{margin:0}.territory-rail nav{display:grid;gap:var(--space-1);margin-top:var(--space-4)}.territory-rail nav a{text-decoration:none}.trail-list{border-top:1px solid var(--color-border);list-style:none;margin:0;padding:0}.trail-list li{align-items:baseline;border-bottom:1px solid var(--color-border);display:flex;gap:var(--space-2);justify-content:space-between;padding:var(--space-2) 0}.trail-list a{text-decoration:none}.trail-list span{color:var(--color-muted);font-family:var(--font-mono);font-size:var(--text-xs);letter-spacing:var(--label-tracking);white-space:nowrap}.empty{color:var(--color-muted)}@media (max-width:52rem){.territory-grid{grid-template-columns:minmax(0,1fr)}.territory-rail{border-left:0;border-top:2px solid var(--local-accent,var(--color-accent));padding:var(--space-3) 0 0;position:static}}
</style>
