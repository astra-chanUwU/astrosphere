---
import { render } from "astro:content";
import ArchivePageHeader from "../components/ArchivePageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPages } from "../lib/content";

const about = (await getPublishedPages()).find((page) => page.data.pageType === "about");
if (!about) throw new Error("A published page with pageType: about is required for /about.");
const { Content } = await render(about);
---

<BaseLayout title={about.data.title} description={about.data.summary}>
  <div class="page-shell about-page">
    <ArchivePageHeader eyebrow="About the person and the archive" title={about.data.title} variant="about" summary={about.data.summary} />
    <div class="about-grid">
      <main>
        <div class="section-heading"><div><p class="eyebrow">A short introduction</p><h2 id="about-heading">The archive and the person behind it</h2></div></div>
        <article class="prose about-copy" aria-labelledby="about-heading"><Content/></article>
      </main>
      <aside class="about-rail">
        <nav class="about-links" aria-labelledby="about-links-title">
          <p id="about-links-title" class="eyebrow">On this page</p>
          <a href="#about-me">About me <span>01</span></a>
          <a href="#about-astrosphere">AstroSphere <span>02</span></a>
          <a href="#why-it-exists">Why it exists <span>03</span></a>
          <a href="#how-i-work">How I work <span>04</span></a>
          <a href="#what-to-explore">Explore <span>05</span></a>
        </nav>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page { max-width: 96rem; padding-bottom: var(--section-space); }
  .about-grid { align-items: start; display: grid; gap: clamp(2rem, 4vw, 4rem); grid-template-columns: minmax(0, 1.5fr) minmax(16rem, .75fr); }
  .section-heading { align-items: end; border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; padding-bottom: var(--space-2); }
  .section-heading h2 { font-family: var(--font-serif); font-size: clamp(1.6rem, 3vw, 2.5rem); font-weight: 500; line-height: var(--leading-tight); margin: 0; }
  .eyebrow { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); margin: 0 0 var(--space-1); text-transform: uppercase; }
  .about-copy { border-top: 1px solid var(--color-border); max-width: var(--reading-width); padding-top: var(--space-3); }
  .about-copy :global(h2) { border-top: 2px solid var(--color-accent); font-size: var(--text-xl); font-weight: 500; margin: var(--space-5) 0 var(--space-2); padding-top: var(--space-2); scroll-margin-top: var(--space-3); }
  .about-copy :global(h2:first-child) { margin-top: 0; }
  .about-copy :global(ul) { margin-top: 0; }
  .about-rail { border-left: 1px solid var(--color-border); padding-left: var(--space-3); }
  .about-links { display: grid; }
  .about-links a { align-items: baseline; border-bottom: 1px solid var(--color-border); color: var(--color-text); display: flex; font-family: var(--font-serif); font-size: var(--text-xl); justify-content: space-between; padding: var(--space-1) 0; text-decoration: none; }
  .about-links a span { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); }
  .about-links a:hover { color: var(--color-accent); }
  @media (max-width: 52rem) { .about-grid { grid-template-columns: minmax(0, 1fr); } .about-rail { border-left: 0; border-top: 1px solid var(--color-border); padding: var(--space-3) 0 0; } }
</style>
