---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SignalCard from "../../components/SignalCard.astro";
import FieldGuideRail from "../../components/FieldGuideRail.astro";
import ArchivePageHeader from "../../components/ArchivePageHeader.astro";
import { getPublishedSignals } from "../../lib/content";

const signals = await getPublishedSignals();
const sections = [
  { id: "manga", title: "Manga" },
  { id: "art-imageboards", title: "Art & Imageboards" },
  { id: "hentai-reading", title: "Hentai Reading" },
  { id: "anime", title: "Anime" },
  { id: "anime-physical", title: "Anime & Physical" },
  { id: "community", title: "Community" },
] as const;
---

<BaseLayout title="Links" description="Websites worth returning to." pagefindFilters={[{ name: "kind", value: "signals" }, ...signals.flatMap((signal) => signal.data.tags.map((value) => ({ name: "tag", value }))), ...signals.flatMap((signal) => signal.data.spheres.map((value) => ({ name: "sphere", value })))]}>
  <div class="page-shell signals-page">
    <ArchivePageHeader eyebrow="External references" title="Links" variant="signals" summary={`${signals.length} websites, archives, and reading rooms.`} />
    <div class="field-guide-grid"><main>{sections.map((section) => {
      const entries = signals.filter((signal) => signal.data.category === section.id);
      return entries.length > 0 && <section class="signal-section" aria-labelledby={`${section.id}-heading`}><h2 id={`${section.id}-heading`}>{section.title}<span>{entries.length}</span></h2>{entries.map((signal) => <SignalCard {signal} />)}</section>;
    })}</main><FieldGuideRail active="signals" /></div>
  </div>
</BaseLayout>

<style>
  .signals-page { max-width: 96rem; }
  .field-guide-grid { align-items: start; display: grid; gap: clamp(2rem, 4cqi, 4rem); grid-template-columns: minmax(0, 1.5fr) minmax(16rem, .75fr); }
  .signal-section { margin: 0 0 var(--space-5); }
  .signal-section h2 { align-items: baseline; border-bottom: 1px solid var(--color-border); display: flex; font-family: var(--font-serif); font-size: var(--text-xl); font-weight: 500; justify-content: space-between; line-height: var(--leading-tight); margin: 0; padding-bottom: var(--space-1); }
  .signal-section h2 span { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 400; letter-spacing: var(--label-tracking); }
  @container content (max-width: 52rem) { .field-guide-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
