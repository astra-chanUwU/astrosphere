---
import { getPublishedTrails } from "../../../lib/content";
import { ARCHIVE_PAGE_SIZE } from "../../../lib/archive";

export async function getStaticPaths() {
  const lastPage = Math.ceil((await getPublishedTrails()).length / ARCHIVE_PAGE_SIZE);
  return Array.from({ length: Math.max(0, lastPage - 1) }, (_, index) => ({ params: { page: String(index + 2) } }));
}

return Astro.redirect(`/guides/page/${Astro.params.page}`, 301);
---
