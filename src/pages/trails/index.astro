---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchivePagination from "../../components/ArchivePagination.astro";
import TrailCard from "../../components/TrailCard.astro";
import FieldGuideRail from "../../components/FieldGuideRail.astro";
import { ARCHIVE_PAGE_SIZE } from "../../lib/archive";
import { getPublishedSpheres, getPublishedTrails } from "../../lib/content";

const [publishedTrails, spheres] = await Promise.all([getPublishedTrails(), getPublishedSpheres()]);
const trails = [...publishedTrails].sort((left, right) => Number(right.data.featured) - Number(left.data.featured) || left.data.title.localeCompare(right.data.title));
const sphereNames = new Map(spheres.map((sphere) => [sphere.data.slug, sphere.data.title]));
const currentPage = 1;
const lastPage = Math.ceil(trails.length / ARCHIVE_PAGE_SIZE);
---
<BaseLayout title="Trails" description="Hand-made routes through Astro Chan's collection of manga, games, images, essays, and strange connections.">
  <div class="page-shell trail-route-map">
    <header class="trail-header"><div><p class="eyebrow">Connected routes</p><h1>Trails</h1><p>{trails.length} routes through the archive.</p></div></header>
    <div class="field-guide-grid"><main><div class="section-heading"><h2 id="trails-heading">All trails</h2><a href="/explore">Explore index →</a></div><section class="trails" aria-labelledby="trails-heading">{trails.slice(0, ARCHIVE_PAGE_SIZE).map((trail, index) => <TrailCard {trail} {index} {sphereNames} />)}<ArchivePagination basePath="/trails" {currentPage} {lastPage} /></section></main><FieldGuideRail active="trails" /></div>
  </div>
</BaseLayout>
<style>
  .trail-header { padding: var(--section-space) 0 var(--section-space); }
  .eyebrow { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); text-transform: uppercase; }
  .eyebrow { margin: 0 0 var(--space-2); }
  h1, h2 { font-family: var(--font-serif); font-weight: 400; line-height: var(--leading-tight); }
  h1 { font-size: clamp(2.5rem, 7vw, 5rem); letter-spacing: -.045em; margin: 0; }
  .trail-header > div:first-child > p:last-child { font-family: var(--font-serif); font-size: var(--text-lg); line-height: var(--leading-reading); margin: var(--space-1) 0 0; }
  .field-guide-grid { align-items: start; display: grid; gap: clamp(3rem, 7vw, 8rem); grid-template-columns: minmax(0, 1.5fr) minmax(16rem, .75fr); }
  .section-heading { align-items: end; border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; padding-bottom: var(--space-2); }
  .section-heading h2 { font-size: var(--text-xl); margin: 0; }
  .section-heading a { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); text-transform: uppercase; }
  .trails { border-top: 1px solid var(--color-border); }
  @media (max-width: 52rem) { .field-guide-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
