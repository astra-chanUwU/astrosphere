---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchivePagination from "../../components/ArchivePagination.astro";
import TrailCard from "../../components/TrailCard.astro";
import { ARCHIVE_PAGE_SIZE } from "../../lib/archive";
import { getPublishedSpheres, getPublishedTrails } from "../../lib/content";

const [publishedTrails, spheres] = await Promise.all([getPublishedTrails(), getPublishedSpheres()]);
const trails = [...publishedTrails].sort((left, right) => Number(right.data.featured) - Number(left.data.featured) || left.data.title.localeCompare(right.data.title));
const sphereNames = new Map(spheres.map((sphere) => [sphere.data.slug, sphere.data.title]));
const currentPage = 1;
const lastPage = Math.ceil(trails.length / ARCHIVE_PAGE_SIZE);
---
<BaseLayout title="Trails" description="Hand-made routes through Astro Chan's collection of manga, games, images, essays, and strange connections.">
  <div class="page-shell trail-route-map">
    <header class="trail-header">
      <div><p class="eyebrow">Field guide / routes 02</p><h1>Trails</h1><p>Short routes through the collection, made for following a mood, a subject, or one curious idea into the next.</p></div>
      <div class="trail-stats"><strong>{trails.length}</strong><span>routes<br/>to wander</span></div>
    </header>
    <div class="route-intro"><span class="route-line" aria-hidden="true"></span><p><strong>Choose a starting point.</strong> Each route is a hand-made sequence of connected artifacts, spheres, and signals.</p></div>
    <section class="trails" aria-label="Available trails">{trails.slice(0, ARCHIVE_PAGE_SIZE).map((trail, index) => <TrailCard {trail} {index} {sphereNames} />)}<ArchivePagination basePath="/trails" {currentPage} {lastPage} /></section>
  </div>
</BaseLayout>
<style>
  .trail-header { align-items: end; display: flex; gap: var(--space-4); justify-content: space-between; max-width: 62rem; padding: var(--section-space) 0 clamp(2rem, 5vw, 4rem); }
  .eyebrow { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); text-transform: uppercase; }
  .eyebrow { margin: 0 0 var(--space-2); }
  h1, h2 { font-family: var(--font-serif); font-weight: 400; line-height: var(--leading-tight); }
  h1 { font-size: clamp(3rem, 8vw, 7.5rem); letter-spacing: -.045em; margin: 0; }
  .trail-header > div:first-child > p:last-child { font-family: var(--font-serif); font-size: clamp(1.05rem, 2vw, 1.35rem); line-height: var(--leading-reading); margin: var(--space-2) 0 0; max-width: 39rem; }
  .trail-stats { align-items: center; color: var(--color-muted); display: flex; font-family: var(--font-mono); gap: var(--space-2); text-transform: uppercase; }
  .trail-stats strong { color: var(--color-accent-warm); font-family: var(--font-serif); font-size: clamp(3rem, 7vw, 6rem); font-weight: 400; letter-spacing: -.08em; line-height: .8; }
  .trail-stats span { font-size: var(--text-xs); letter-spacing: var(--label-tracking); }
  .route-intro { align-items: center; border-block: 1px solid var(--color-border); display: flex; gap: var(--space-2); margin-bottom: var(--space-4); padding: var(--space-2) 0; }
  .route-intro p { margin: 0; }
  .route-line { background: var(--color-accent-warm); border-radius: 50%; display: block; height: .65rem; position: relative; width: .65rem; }
  .route-line::after { border-top: 1px dashed var(--color-accent-warm); content: ""; left: .65rem; position: absolute; top: 50%; width: 2.5rem; }
  .trails { max-width: var(--reading-width); }
  @media (max-width: 48rem) { .trail-header { align-items: start; flex-direction: column; } }
</style>
