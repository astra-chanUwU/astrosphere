---
import type { MangaChapterEntry, MangaSeriesEntry } from "../lib/content";
import { createMangaPageSrc, getMangaChapterAvailabilityLabel, getMangaChapterPages, getMangaInstallmentLabel } from "../lib/manga-reader";

interface ChapterLink { href: string; label: string; }
interface Props {
  series: MangaSeriesEntry;
  chapter: MangaChapterEntry;
  previousChapter?: ChapterLink;
  nextChapter?: ChapterLink;
}
const { series, chapter, previousChapter, nextChapter } = Astro.props;
const pages = getMangaChapterPages(chapter.data);
const availabilityLabel = getMangaChapterAvailabilityLabel(chapter.data);
const unavailable = chapter.data.availability === "unavailable";
const installmentLabel = getMangaInstallmentLabel(series.data.format, chapter.data.number, chapter.data.title);
---

<article class="reader">
  <header data-reader-header><a href={`/manga/${series.data.slug}`}>← {series.data.title}</a><h1>{installmentLabel}</h1><p>{availabilityLabel}</p></header>
  <nav class="chapter-navigation" aria-label="Chapter navigation">
    {previousChapter && <a href={previousChapter.href}>← {previousChapter.label}</a>}
    <a href={`/manga/${series.data.slug}`}>Series details</a>
    {nextChapter && <a href={nextChapter.href}>{nextChapter.label} →</a>}
  </nav>
  <div class="reader-pages">
    {series.data.format === "doujinshi" && !unavailable && <nav class="page-preview" aria-label="Page previews">
      <ol>
        {pages.map((page) => <li><a href={`#page-${page}`}><img src={createMangaPageSrc(chapter.data.pagePath!, page, chapter.data.pageExtension)} alt={`Preview page ${page}`} width={chapter.data.pageWidth!} height={chapter.data.pageHeight!} loading="lazy" decoding="async" /><span>{page}</span></a></li>)}
      </ol>
    </nav>}
    {unavailable ? <p class="unavailable">This chapter’s media is currently unavailable.</p> : <ol class="page-stack">{pages.map((page) => <li id={`page-${page}`}><img src={createMangaPageSrc(chapter.data.pagePath!, page, chapter.data.pageExtension)} alt={`${series.data.title}, chapter ${chapter.data.number}, page ${page}`} width={chapter.data.pageWidth!} height={chapter.data.pageHeight!} loading={page === 1 ? "eager" : "lazy"} fetchpriority={page === 1 ? "high" : "auto"} decoding="async" /></li>)}</ol>}
  </div>
  <nav class="chapter-navigation" aria-label="Chapter navigation">
    {previousChapter && <a href={previousChapter.href}>← {previousChapter.label}</a>}
    <a href={`/manga/${series.data.slug}`}>Series details</a>
    {nextChapter && <a href={nextChapter.href}>{nextChapter.label} →</a>}
  </nav>
</article>

<style>
  .reader { margin: 0 auto; max-width: min(100%, 62rem); } header { align-items: baseline; border-bottom: 1px solid var(--color-border); display: flex; flex-wrap: wrap; gap: var(--space-2); justify-content: space-between; padding: var(--space-2) var(--space-3); } h1 { font-size: var(--text-lg); margin: 0; } header p { color: var(--color-muted); font-size: var(--text-sm); margin: 0; } .chapter-navigation { align-items: center; border-bottom: 1px solid var(--color-border); display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: center; padding: var(--space-2) var(--space-3); } .chapter-navigation a { align-items: center; display: flex; min-height: 2.75rem; padding: 0 var(--space-1); } .reader-pages { display: grid; gap: var(--space-3); grid-template-columns: minmax(4.5rem, 6rem) minmax(0, 1fr); } .page-preview { align-self: start; max-height: calc(100vh - 6rem); overflow-y: auto; position: sticky; top: var(--space-3); } .page-preview ol { display: grid; gap: .35rem; grid-template-columns: repeat(2, minmax(0, 1fr)); list-style: none; margin: 0; padding: var(--space-2) 0; } .page-preview li { margin: 0; } .page-preview a { color: var(--color-muted); display: block; font-size: var(--text-xs); text-align: center; text-decoration: none; } .page-preview img { aspect-ratio: 2 / 3; background: var(--color-surface); display: block; height: auto; margin: 0 auto .15rem; object-fit: contain; width: 100%; } .page-preview a:hover, .page-preview a:focus-visible { color: var(--color-text); } .page-stack { list-style: none; margin: 0; padding: 0; } .page-stack li { margin: 0; scroll-margin-top: var(--space-3); } .unavailable { color: var(--color-muted); margin: var(--space-5) auto; padding: var(--space-3); text-align: center; } .page-stack img { display: block; height: auto; margin: 0 auto; max-width: 100%; width: auto; } @media (max-width: 48rem) { header { padding-inline: var(--space-2); } header a { align-items: center; display: flex; min-height: 2.75rem; } .chapter-navigation { padding-inline: var(--space-2); } .reader-pages { display: block; } .page-preview { max-height: none; overflow-x: auto; overflow-y: hidden; position: static; } .page-preview ol { display: flex; gap: .35rem; overflow-x: auto; padding-inline: var(--space-2); } .page-preview li { flex: 0 0 4.5rem; } .page-stack img { width: 100%; } }
</style>
