---
import type { MangaSeriesEntry } from "../lib/content";
import { getMangaPublicPath } from "../lib/manga-reader";

interface Props { series: MangaSeriesEntry; chapterCount: number; }
const { series, chapterCount } = Astro.props;
const href = getMangaPublicPath(series.data.format, series.data.slug);
---

<article data-manga-rating={series.data.rating}>
  <a class="cover" {href}>
    {series.data.cover && <img src={series.data.cover.src} alt={series.data.cover.alt ?? `${series.data.title} cover`} loading="lazy" decoding="async" />}
  </a>
  <div class="details"><p class="format">{series.data.format.replace("one-shot", "one-shot").replace("web-comic", "web comic")}</p><h2><a {href}>{series.data.title}</a></h2><p class="original">{series.data.originalTitle}</p><p class="meta">{series.data.status} · {chapterCount} {chapterCount === 1 ? "chapter" : "chapters"}</p><p class="credits"><span>Author: {series.data.authors.map((person) => <a href={`/manga/creators/${person.slug}`}>{person.name}</a>)}</span><span>Artist: {series.data.artists.map((person) => <a href={`/manga/creators/${person.slug}`}>{person.name}</a>)}</span></p><p class="tags">{series.data.tags.map((tag) => <a href={`/tags/${tag}`}>{tag}</a>)}</p></div>
</article>

<style>
  article { border-top: 1px solid var(--color-border); display: grid; gap: var(--space-3); grid-template-columns: 7rem minmax(0, 1fr); padding: var(--space-3) 0; }
  .cover { align-self: start; background: var(--color-surface); display: block; } img { height: auto; width: 100%; }
  h2 { font-size: var(--text-xl); margin: 0; } h2 a { text-decoration: none; }
  p { margin: var(--space-1) 0; } .format { color: var(--color-accent); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); text-transform: uppercase; }.original,.meta,.credits,.tags { color: var(--color-muted); font-size: var(--text-sm); }.credits { display: flex; flex-wrap: wrap; gap: .3rem .8rem; }.credits span { display: inline-flex; flex-wrap: wrap; gap: .3rem; }.credits a { color: inherit; }.tags { display: flex; flex-wrap: wrap; gap: .3rem .8rem; text-transform: capitalize; }
  :global(html[data-sfw="on"]) article[data-manga-rating="explicit"] { display: none; }
  @media (max-width: 34rem) { article { grid-template-columns: 5rem minmax(0, 1fr); } }
</style>
