---
import type { MangaSeriesEntry } from "../lib/content";
import { createMangaCoverPreviewSrc, getMangaPublicPath } from "../lib/manga-reader";

interface Props { series: MangaSeriesEntry; chapterCount: number; compact?: boolean; }
const { series, chapterCount, compact = false } = Astro.props;
const href = getMangaPublicPath(series.data.format, series.data.slug);
---

<article class:list={{ compact }} data-manga-rating={series.data.rating}>
  <a class="cover" {href}>
    {series.data.cover && <img src={createMangaCoverPreviewSrc(series.data.format, series.data.slug, series.data.cover.src)} alt={series.data.cover.alt ?? `${series.data.title} cover`} loading="lazy" decoding="async" />}
  </a>
  <div class="details"><p class="format">{series.data.format.replace("one-shot", "one-shot").replace("web-comic", "web comic")}</p><h2><a {href}>{series.data.title}</a></h2><p class="original">{series.data.originalTitle}</p><p class="meta">{series.data.status} · {chapterCount} {chapterCount === 1 ? "chapter" : "chapters"}</p>{!compact && <p class="credits"><span>Author: {series.data.authors.map((person) => <a href={`/manga/creators/${person.slug}`}>{person.name}</a>)}</span><span>Artist: {series.data.artists.map((person) => <a href={`/manga/creators/${person.slug}`}>{person.name}</a>)}</span></p>}</div>
  <div class="tag-list"><p class="tags">{series.data.tags.slice(0, 4).map((tag) => <a href={`/tags/${tag}`}>{tag}</a>)}</p>{series.data.tags.length > 4 && <details><summary>+{series.data.tags.length - 4} tags<span class="sr-only"> for {series.data.title}</span></summary><p class="tags">{series.data.tags.slice(4).map((tag) => <a href={`/tags/${tag}`}>{tag}</a>)}</p></details>}</div>
</article>

<style>
  article { border-top: 1px solid var(--color-border); display: grid; gap: var(--space-3); grid-template-columns: 7rem minmax(0, 1fr); padding: var(--space-3) 0; }
  .tag-list { grid-column: 1 / -1; }
  .tag-list:has(.tags:empty) { display: none; }
  .tag-list summary { color: var(--color-muted); cursor: pointer; font-size: var(--text-sm); padding-block: .35rem; width: fit-content; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  article.compact { grid-template-columns: 4.5rem minmax(0, 1fr); column-gap: var(--space-2); row-gap: var(--space-1); }
  .compact h2 { font-size: 1.1rem; line-height: var(--leading-tight); }
  @container cards (max-width: 25rem) { article { grid-template-columns: 4.5rem minmax(0, 1fr); gap: var(--space-2); } }
  .cover { align-self: start; background: var(--color-surface); display: block; } img { height: auto; width: 100%; }
  h2 { font-size: var(--text-xl); margin: 0; } h2 a { text-decoration: none; }
  p { margin: var(--space-1) 0; } .format { color: var(--color-accent); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); text-transform: uppercase; }.original,.meta,.credits,.tags { color: var(--color-muted); font-size: var(--text-sm); }.credits { display: flex; flex-wrap: wrap; gap: .3rem .8rem; }.credits span { display: inline-flex; flex-wrap: wrap; gap: .3rem; }.credits a { color: inherit; }.tags { display: flex; flex-wrap: wrap; gap: .3rem .8rem; text-transform: capitalize; }
  :global(html[data-sfw="on"]) article[data-manga-rating="explicit"] { display: none; }
  @container content (max-width: 34rem) { article { grid-template-columns: 5rem minmax(0, 1fr); } }
</style>
