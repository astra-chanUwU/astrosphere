---
import type { MangaChapterEntry, MangaSeriesEntry } from "../lib/content";
import { getMangaChapterAvailabilityLabel, getMangaInstallmentLabel, getMangaPublicPath } from "../lib/manga-reader";
interface Props { series: MangaSeriesEntry; chapters: MangaChapterEntry[]; }
const { series, chapters } = Astro.props;
const collectionLabel = series.data.format === "doujinshi" ? "Doujinshi" : series.data.format === "one-shot" ? "One-shots" : "Chapters";
const chapterName = (chapter: MangaChapterEntry): string => chapter.data.title;
---

<section aria-labelledby="chapters-heading"><h2 id="chapters-heading">{collectionLabel}</h2>{chapters.length ? <ol>{chapters.map((chapter) => <li><a href={getMangaPublicPath(series.data.format, series.data.slug, chapter.data.slug)}>{getMangaInstallmentLabel(series.data.format, chapter.data.number, series.data.format === "doujinshi" ? undefined : chapter.data.title)}{chapter.data.title !== `Chapter ${chapter.data.number}` && !chapter.data.title.startsWith("Volume ") || series.data.format === "doujinshi" ? ` — ${chapterName(chapter)}` : ""}</a><span>{getMangaChapterAvailabilityLabel(chapter.data)}</span></li>)}</ol> : <p>No published installments yet.</p>}</section>

<style>section { margin-top: var(--space-4); max-width: var(--reading-width); } h2 { font-size: var(--text-xl); } ol { list-style: none; margin: 0; padding: 0; } li { border-top: 1px solid var(--color-border); display: flex; justify-content: space-between; gap: var(--space-2); padding: var(--space-2) 0; } a { text-decoration: none; } span { color: var(--color-muted); font-size: var(--text-sm); white-space: nowrap; }</style>
