---
import type { MangaChapterEntry, MangaSeriesEntry } from "../lib/content";
import { getMangaInstallmentLabel } from "../lib/manga-reader";

interface Props { series: MangaSeriesEntry; chapters: MangaChapterEntry[]; art: MangaSeriesEntry["data"]["art"]; }
const { series, chapters, art } = Astro.props;
const first = chapters[0];
const latest = chapters.at(-1);
const chapterHref = (chapter: MangaChapterEntry): string => `/manga/${series.data.slug}/${chapter.data.slug}`;
const chapterLabel = (chapter: MangaChapterEntry): string => {
  const label = getMangaInstallmentLabel(series.data.format, chapter.data.number, series.data.format === "doujinshi" ? undefined : chapter.data.title);
  return chapter.data.title !== `Chapter ${chapter.data.number}` && !chapter.data.title.startsWith("Volume ") || series.data.format === "doujinshi"
    ? `${label} — ${chapter.data.title}`
    : label;
};
---

<aside class="manga-navigator" aria-label="Manga chapter navigator">
  <p class="eyebrow">Series navigator</p>
  <h2>Chapters</h2>
  {chapters.length ? <>
    <p class="count">{chapters.length} {chapters.length === 1 ? "chapter" : "chapters"}</p>
    <nav aria-label="Chapter shortcuts">
      {first && <a href={chapterHref(first)}>First chapter</a>}
      {latest && <a href={chapterHref(latest)}>Latest chapter</a>}
    </nav>
    <label for="manga-chapter-jump">Jump to chapter</label>
    <select id="manga-chapter-jump" onchange="if (this.value) window.location.href = this.value">
      <option value="">Choose a chapter…</option>
      {chapters.map((chapter) => <option value={chapterHref(chapter)}>{chapterLabel(chapter)}</option>)}
    </select>
    <div class="chapter-grid" aria-label="Numbered chapters">
      {chapters.map((chapter) => <a href={chapterHref(chapter)} aria-label={chapterLabel(chapter)}>{chapter.data.number}</a>)}
    </div>
  </> : <p>No chapters yet.</p>}
  {art.length > 0 && <section class="art-preview" aria-labelledby="navigator-art-heading">
    <h2 id="navigator-art-heading">Artwork</h2>
    <div class="art-grid">
      {art.map((piece) => <a href={piece.src} target="_blank" rel="noopener noreferrer"><img src={piece.src} alt={piece.alt ?? "Manga artwork"} loading="lazy" decoding="async" /></a>)}
    </div>
    <a class="art-gallery-link" href="#art-heading">Open full artwork gallery</a>
  </section>}
</aside>

<style>
  .manga-navigator { align-self: start; border-left: 1px solid var(--color-border); max-width: 16rem; padding: var(--space-2) 0 var(--space-2) var(--space-3); position: sticky; top: var(--space-3); }
  .eyebrow { color: var(--color-muted); font-size: var(--text-sm); margin: 0; text-transform: uppercase; }
  h2 { font-size: var(--text-xl); margin: var(--space-1) 0; }
  .count { color: var(--color-muted); font-size: var(--text-sm); margin: 0 0 var(--space-2); }
  nav { display: grid; gap: var(--space-1); margin-bottom: var(--space-3); }
  nav a { text-decoration: none; }
  label { display: block; font-size: var(--text-sm); margin-bottom: var(--space-1); }
  select { background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text); font: inherit; max-width: 100%; padding: .35rem; width: 100%; }
  .chapter-grid { display: grid; gap: .25rem; grid-template-columns: repeat(6, minmax(0, 1fr)); margin-top: var(--space-3); }
  .chapter-grid a { border: 1px solid var(--color-border); padding: .25rem .1rem; text-align: center; text-decoration: none; }
  .chapter-grid a:hover, .chapter-grid a:focus-visible { border-color: var(--color-text); }
  .art-preview { border-top: 1px solid var(--color-border); margin-top: var(--space-4); padding-top: var(--space-3); }
  .art-preview h2 { margin-top: 0; }
  .art-grid { display: grid; gap: .35rem; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .art-grid img { aspect-ratio: 1; object-fit: cover; width: 100%; }
  .art-gallery-link { display: inline-block; font-size: var(--text-sm); margin-top: var(--space-2); }
  @media (max-width: 52rem) { .manga-navigator { border-left: 0; border-top: 1px solid var(--color-border); max-width: var(--reading-width); padding: var(--space-3) 0 0; position: static; } }
</style>
