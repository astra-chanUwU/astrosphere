---
import type { TrailProgress as TrailProgressModel } from "../lib/content";

interface Props { progress: TrailProgressModel; }
const { progress } = Astro.props;
const { trail, targets, currentIndex } = progress;
const previous = targets[currentIndex - 1];
const next = targets[currentIndex + 1];
const steps = targets.map((target, index) => ({
  target,
  index,
  complete: index <= currentIndex,
  current: index === currentIndex,
}));
---
<section class="trail-progress" aria-labelledby={`trail-progress-${trail.data.slug}`}>
  <div class="trail-progress-heading">
    <div>
      <p class="eyebrow">Reading trail</p>
      <h2 id={`trail-progress-${trail.data.slug}`}><a href={`/trails/${trail.data.slug}`}>{trail.data.title}</a></h2>
    </div>
    <span class="trail-count">{currentIndex + 1} of {targets.length}</span>
  </div>
  <nav aria-label={`${trail.data.title} progress`}>
    {previous && <a class="trail-arrow" href={previous.href} aria-label={`Previous: ${previous.entry.data.title}`} title={`Previous: ${previous.entry.data.title}`} target={previous.external ? "_blank" : undefined} rel={previous.external ? "noopener noreferrer" : undefined}>←<span class="sr-only">Previous: {previous.entry.data.title}</span></a>}
    <ol>
      {steps.map((step) => <li class={`${step.complete ? "list-complete" : ""} ${step.current ? "list-current" : ""}`}>
          <a
            href={step.target.href}
            aria-current={step.current ? "page" : undefined}
            aria-label={`Step ${step.index + 1}: ${step.target.entry.data.title}${step.current ? " (current)" : ""}`}
            title={`${step.index + 1}. ${step.target.entry.data.title}`}
            target={step.target.external ? "_blank" : undefined}
            rel={step.target.external ? "noopener noreferrer" : undefined}
          ><span aria-hidden="true"></span><span class="sr-only">{step.index + 1}. {step.target.entry.data.title}</span></a>
        </li>)}
    </ol>
    {next && <a class="trail-arrow" href={next.href} aria-label={`Next: ${next.entry.data.title}`} title={`Next: ${next.entry.data.title}`} target={next.external ? "_blank" : undefined} rel={next.external ? "noopener noreferrer" : undefined}>→<span class="sr-only">Next: {next.entry.data.title}</span></a>}
  </nav>
</section>

<style>
  .trail-progress { border-top: var(--border-width) solid var(--color-border); margin-top: var(--section-space); max-width: var(--reading-width); padding-top: var(--space-3); }
  .trail-progress-heading { align-items: end; display: flex; justify-content: space-between; gap: var(--space-2); }
  .eyebrow, .trail-count { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); margin: 0; text-transform: uppercase; }
  h2 { font-family: var(--font-serif); font-size: var(--text-lg); font-weight: 500; margin: var(--space-1) 0 0; }
  h2 a { color: inherit; text-decoration: none; }
  nav { align-items: center; display: flex; gap: var(--space-2); padding: var(--space-3) 0 var(--space-1); }
  ol { align-items: center; display: flex; flex: 1; list-style: none; margin: 0; padding: 0; }
  li { align-items: center; display: flex; flex: 1; }
  li:last-child { flex: 0 1 auto; }
  li::after { background: var(--color-border); content: ""; display: block; flex: 1; height: var(--border-width); margin: 0 var(--space-1); }
  li.list-complete::after { background: var(--color-accent); }
  li:last-child::after { display: none; }
  a { color: var(--color-muted); display: block; }
  .trail-arrow { color: var(--color-text); font-size: var(--text-lg); line-height: 1; text-decoration: none; }
  .trail-arrow:hover { color: var(--color-accent); }
  a span:first-child { background: var(--color-border); border: var(--border-width) solid var(--color-border); border-radius: 50%; display: block; height: .7rem; width: .7rem; }
  .list-complete a span:first-child { background: var(--color-accent); border-color: var(--color-accent); }
  .list-current a span:first-child { box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent) 20%, transparent); }
  a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .sr-only { height: 1px; margin: -1px; overflow: hidden; position: absolute; width: 1px; clip: rect(0, 0, 0, 0); }
  @media (max-width: 30rem) { .trail-progress-heading { align-items: start; flex-direction: column; gap: var(--space-1); } }
</style>
