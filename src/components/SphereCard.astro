---
import type { CollectionEntry } from "astro:content";
import { createManagedImageThumbnailSrc } from "../lib/managed-image-thumbnails";

interface Props {
  sphere: CollectionEntry<"spheres">;
  childCount?: number;
  artifactCount?: number;
}

const { sphere, childCount = 0, artifactCount = 0 } = Astro.props;
const coverPreview = sphere.data.cover?.kind === "image"
  ? createManagedImageThumbnailSrc(sphere.data.cover.src)
  : undefined;
---

<article class:list={["sphere-row", { "sphere-row--has-cover": sphere.data.cover?.kind === "image" }]} data-palette={sphere.data.palette}>
  {sphere.data.cover?.kind === "image" && <a class="cover" href={`/topics/${sphere.data.slug}`} aria-label={`Enter ${sphere.data.title}`}><img src={coverPreview} alt={sphere.data.cover.alt ?? sphere.data.title} width={sphere.data.cover.width} height={sphere.data.cover.height} loading="lazy" decoding="async" /></a>}
  <div class="details">
    <p class="marker">{sphere.data.palette}</p>
    <h2><a href={`/topics/${sphere.data.slug}`}>{sphere.data.title}</a></h2>
    <p class="summary">{sphere.data.summary}</p>
    <footer>{childCount > 0 && <span>{childCount} child {childCount === 1 ? "sphere" : "spheres"}</span>}<span>{artifactCount} {artifactCount === 1 ? "artifact" : "artifacts"}</span></footer>
  </div>
</article>

<style>
  .sphere-row { border-top: 1px solid var(--color-border); display: grid; gap: var(--space-3); padding: var(--space-3) 0; }
  .sphere-row--has-cover { grid-template-columns: 7rem minmax(0, 1fr); }
  [data-palette="paper"] { --sphere-accent: var(--color-paper); } [data-palette="moss"] { --sphere-accent: var(--color-moss); } [data-palette="ember"] { --sphere-accent: var(--color-ember); } [data-palette="ocean"] { --sphere-accent: var(--color-ocean); } [data-palette="dusk"] { --sphere-accent: var(--color-dusk); } [data-palette="mineral"] { --sphere-accent: var(--color-mineral); }
  .marker, footer { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); text-transform: uppercase; }
  .marker { color: var(--sphere-accent); margin: 0 0 var(--space-1); }
  h2 { font-size: var(--text-xl); margin: 0; }
  h2 a { color: inherit; text-decoration: none; }
  .summary { color: var(--color-muted); line-height: var(--leading-reading); margin: var(--space-1) 0; max-width: 42rem; }
  footer { display: flex; flex-wrap: wrap; gap: .5rem 1rem; }
  .cover { align-self: start; background: var(--color-surface); display: block; }
  .cover img { aspect-ratio: 1 / 1; display: block; height: auto; object-fit: cover; width: 100%; }
  @media (max-width: 32rem) { .sphere-row--has-cover { grid-template-columns: 5rem minmax(0, 1fr); } }
</style>
