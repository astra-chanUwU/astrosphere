---
import type { MangaSeriesEntry } from "../lib/content";

interface Props {
  art: MangaSeriesEntry["data"]["art"];
}

const { art } = Astro.props;
---

{art.length > 0 && (
  <section class="gallery" aria-labelledby="art-heading">
    <h2 id="art-heading">Artwork</h2>
    <div class="art-grid">
      {art.map((piece) => {
        const src = piece.src;
        return (
          <figure>
            <img {src} alt={piece.alt} loading="lazy" decoding="async" />
            {piece.caption && <figcaption>{piece.caption}</figcaption>}
            <a class="full-size-link" href={src} target="_blank" rel="noopener noreferrer">Open full size</a>
          </figure>
        );
      })}
    </div>
  </section>
)}

<style>
  .gallery { margin: var(--section-space) 0; max-width: var(--reading-width); }
  h2 { font-size: var(--text-xl); margin: 0 0 var(--space-2); }
  .art-grid { display: grid; gap: var(--space-2); grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  figure { margin: 0; }
  img { display: block; height: auto; width: 100%; }
  figcaption { color: var(--color-muted); font-size: var(--text-sm); margin-top: var(--space-1); }
  .full-size-link { border: 1px solid var(--color-border); display: inline-block; font-size: var(--text-sm); margin-top: var(--space-1); padding: 0.35rem 0.55rem; text-decoration: none; }
  .full-size-link:hover, .full-size-link:focus-visible { border-color: var(--color-text); }
</style>
