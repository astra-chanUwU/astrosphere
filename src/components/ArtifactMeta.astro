---
import type { CollectionEntry } from "astro:content";
interface Props { artifact: CollectionEntry<"artifacts">; }
const { artifact } = Astro.props;
const date = artifact.data.publishedAt.toLocaleDateString("en", { year: "numeric", month: "long", day: "numeric" });
---
<dl><div><dt>Published</dt><dd><time datetime={artifact.data.publishedAt.toISOString()}>{date}</time></dd></div>{artifact.data.author && <div><dt>By</dt><dd>{artifact.data.author}</dd></div>}{artifact.data.location && <div><dt>Place</dt><dd>{artifact.data.location}</dd></div>}{artifact.data.duration && <div><dt>Duration</dt><dd>{artifact.data.duration}</dd></div>}<div><dt>Spheres</dt><dd>{artifact.data.spheres.map((sphere) => <a href={`/spheres/${sphere}`}>{sphere}</a>)}</dd></div>{artifact.data.tags.length > 0 && <div><dt>Tags</dt><dd>{artifact.data.tags.map((tag) => <a href={`/tags/${tag}`}>{tag}</a>)}</dd></div>}</dl>
<style>dl{border-block:1px solid var(--color-border);display:grid;gap:var(--space-1);margin:var(--space-3) 0;padding:var(--space-2) 0}div{display:grid;gap:var(--space-1);grid-template-columns:5rem 1fr}dt{color:var(--color-muted);font-size:var(--text-sm)}dd{display:flex;flex-wrap:wrap;gap:.3rem .8rem;margin:0}a{text-transform:capitalize}</style>
