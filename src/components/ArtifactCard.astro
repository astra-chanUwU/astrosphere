---
import type { CollectionEntry } from "astro:content";
interface Props { artifact: CollectionEntry<"artifacts">; visual?: boolean; }
const { artifact, visual = false } = Astro.props;
---
<article class:list={{ "artifact-card--visual": visual }}>
  {visual && artifact.data.hero?.kind === "image" && <a class="artifact-image" href={`/artifacts/${artifact.data.slug}`}><img src={artifact.data.hero.src} alt={artifact.data.hero.alt ?? artifact.data.title} loading="lazy" decoding="async" /></a>}
  <p class="type">{artifact.data.type.replace("-", " ")}</p><h2><a href={`/artifacts/${artifact.data.slug}`}>{artifact.data.title}</a></h2><p class="summary">{artifact.data.summary}</p><time datetime={artifact.data.publishedAt.toISOString()}>{artifact.data.publishedAt.toLocaleDateString("en", { year: "numeric", month: "short", day: "numeric" })}</time>
</article>
<style>article{border-top:1px solid var(--color-border);padding:var(--space-2) 0}.type{color:var(--color-accent);font-size:var(--text-xs);letter-spacing:.1em;margin:0;text-transform:uppercase}h2{font-family:var(--font-serif);font-size:var(--text-xl);font-weight:500;margin:var(--space-1) 0}h2 a{text-decoration:none}.summary{line-height:var(--leading-normal);max-width:40rem}time{color:var(--color-muted);font-size:var(--text-sm)}</style>
<style>
  .artifact-card--visual { display: grid; gap: var(--space-3); grid-template-columns: 7rem minmax(0, 1fr); }
  .artifact-card--visual .artifact-image { grid-row: span 4; }
  .artifact-image { align-self: start; background: var(--color-surface); display: block; }
  .artifact-image img { aspect-ratio: 4 / 3; display: block; height: auto; object-fit: cover; width: 100%; }
</style>
