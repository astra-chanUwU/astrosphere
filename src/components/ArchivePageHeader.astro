---
import PageGlyph from "./PageGlyph.astro";

interface Props {
  eyebrow: string;
  title: string;
  variant: "about" | "contact" | "support" | "explore" | "spheres" | "manga" | "anime" | "doujinshi" | "image-sets" | "trails" | "signals" | "artifacts" | "search" | "dispatches" | "shelf";
  summary?: string;
  pixelTitle?: boolean;
}

const { eyebrow, title, variant, summary, pixelTitle = true } = Astro.props;
---

<header class="archive-page-header">
  <p class="eyebrow">{eyebrow}</p>
  {pixelTitle ? <PageGlyph label={title} {variant} /> : <h1 class="text-title text-title--compact">{title}</h1>}
  {summary && <p class="summary">{summary}</p>}
</header>

<style>
  .archive-page-header { max-width: var(--reading-width); padding: var(--space-3) 0 var(--space-4); }
  .eyebrow { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--label-tracking); margin: 0 0 var(--space-1); text-transform: uppercase; }
  .summary { font-family: var(--font-serif); font-size: var(--text-lg); line-height: var(--leading-reading); margin: var(--space-2) 0 0; }
  .text-title { font-family: var(--font-serif); font-size: clamp(2.5rem, 7vw, 5rem); font-weight: 500; letter-spacing: -.045em; line-height: var(--leading-tight); margin: 0; }
  .text-title--compact { font-size: clamp(1.75rem, 4vw, 3rem); letter-spacing: -.035em; }
</style>
