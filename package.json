{
  "name": "astrosphere",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bun run prepare:search && astro dev",
    "build": "astro build && pagefind --site dist",
    "media:serve": "bun scripts/media.ts serve",
    "media:add": "bun scripts/media.ts add",
    "media:remove": "bun scripts/media.ts remove",
    "media:optimize": "bun scripts/media.ts optimize",
    "media:validate": "bun scripts/media.ts validate",
    "media:sync": "bun scripts/media.ts sync",
    "content:new": "bun scripts/content.ts new",
    "prepare:search": "astro build && pagefind --site dist --output-path public/pagefind",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/bun": "^1.3.14",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3"
  }
}
