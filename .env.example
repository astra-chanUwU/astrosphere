# Unified media CLI configuration. Both public trees live below this one external root.
MEDIA_ROOT=/absolute/path/to/astrosphere-media
MEDIA_PORT=4322
MEDIA_SYNC_TARGET=astro@example.com:/srv/astrosphere/media

# Temporary legacy configuration, superseded by the unified media CLI above.
# Retain until the final cleanup plan removes the remaining legacy scripts.
# External directory containing series folders directly beneath this root.
MANGA_MEDIA_ROOT=/absolute/path/to/astrosphere-media/manga

# External image-set directory; this keeps large galleries out of Git.
IMAGE_SET_MEDIA_ROOT=/absolute/path/to/astrosphere-media/images

MANGA_MEDIA_PORT=4322

# Local-to-VPS synchronization and VPS release root.
VPS_MEDIA_TARGET=astro@example.com:/srv/astrosphere/media/manga
VPS_IMAGE_SET_TARGET=astro@example.com:/srv/astrosphere/media/images
ASTROSPHERE_ROOT=/srv/astrosphere
